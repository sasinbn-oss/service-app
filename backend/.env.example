# From Supabase: click "Connect" on the project dashboard > ORM > Prisma.
# Copy both values exactly as shown there (they differ only in port/host).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-this-secret-in-production"
PORT=4000

# ที่เก็บรูปและวิดีโอที่ช่างแนบในใบงาน — Cloudflare R2
# สร้างถัง (bucket) แล้วสร้าง API token แบบ "Object Read & Write" เฉพาะถังนั้น
# ถ้าไม่ใส่ ระบบอื่นทั้งหมดยังทำงานปกติ แค่แนบรูปในใบงานไม่ได้
#
# ห้ามเปิดถังเป็น public — รูปพวกนี้เป็นภาพหน้าร้านลูกค้า ระบบจะสร้างลิงก์
# ชั่วคราวอายุ 2 ชั่วโมงให้ทีละครั้งเอง ไม่ต้องเปิดสาธารณะ
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="service-app"
# ไม่ต้องใส่ ระบบเดาจาก R2_ACCOUNT_ID ให้เอง — ใส่เฉพาะตอนย้ายไปที่เก็บเจ้าอื่น
R2_ENDPOINT=""
