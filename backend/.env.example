# ค่าจาก Supabase: ปุ่ม Connect > Direct > Session pooler
#
# ใช้ "session pooler" (พอร์ต 5432) ไม่ใช่ "transaction pooler" (พอร์ต 6543)
# ทั้งที่คู่มือส่วนใหญ่แนะนำ 6543 — เพราะ transaction pooler จับคู่การเชื่อมต่อ
# จริงใหม่ทุก transaction และคำสั่งเดี่ยวของ Prisma นับเป็นหนึ่ง transaction
# ทุกคำสั่งจึงจ่ายค่าเปิดการเชื่อมต่อใหม่ทุกครั้ง
#
# วัดจากของจริงแล้วต่างกันห้าเท่า: 1,157 ms ต่อคำสั่งด้วย 6543 เหลือ 234 ms
# ด้วย 5432 (บันทึกใบงานหนึ่งใบ 15 วินาที เหลือ 3 วินาที) แค่เปลี่ยนพอร์ต
# ไม่ได้แก้โค้ดอะไรเลย
#
# 6543 มีไว้สำหรับ serverless ที่โปรเซสเกิดดับตลอดเวลา ส่วน backend นี้เป็น
# Node process ตัวเดียวที่เปิดค้าง จึงเปิดการเชื่อมต่อทิ้งไว้ใช้ซ้ำได้
#
# ห้ามใส่ ?pgbouncer=true กับ session pooler — มันปิด prepared statements
# โดยไม่จำเป็น
# ใส่ connection_limit ด้วย — session pooler ของ Supabase รับได้ 15 client
# พร้อมกัน ส่วน Prisma เปิดตามจำนวน CPU (ปกติ 9 ต่อ instance) ตอน deploy
# ตัวเก่ากับตัวใหม่อยู่พร้อมกันครู่หนึ่งจึงเป็น 18 ซึ่งเกินโควตา แล้ว deploy ล้ม
# ด้วย "FATAL: (EMAXCONNSESSION) max clients reached in session mode"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5"
# migration ควรต่อตรงเข้าฐานข้อมูล (Direct connection) ถ้าเครือข่ายไปถึง
#
# แต่ Supabase ปิด IPv4 ของ direct connection แล้ว ถ้าโฮสต์ที่รันไม่มี IPv6
# (Render ไม่มี) ให้ใช้ pooler ตัวเดียวกับข้างบนไปก่อน — ใช้ได้ แค่ต้องจำกัด
# connection ให้เหลือ 1 เพราะ migrate ใช้แค่เส้นเดียว
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=1"
JWT_SECRET="change-this-secret-in-production"
PORT=4000

# ที่เก็บรูปและวิดีโอที่ช่างแนบในใบงาน — ตอนนี้ใช้ Supabase Storage
# ถ้าไม่ใส่ ระบบอื่นทั้งหมดยังทำงานปกติ แค่แนบรูปในใบงานไม่ได้
#
# หาค่าได้จาก Supabase: Project Settings > Storage > S3 Connection
#   STORAGE_ENDPOINT = ค่า "Endpoint" ที่หน้านั้นแสดง
#   STORAGE_REGION   = ค่า "Region" ที่หน้านั้นแสดง (ต้องตรง ไม่งั้นลิงก์เปิดไฟล์จะใช้ไม่ได้)
#   คีย์สองตัว = กด "New access key" ที่หน้าเดียวกัน
#
# สร้างถังชื่อ service-app ที่เมนู Storage และ **อย่าติ๊ก Public bucket** —
# รูปพวกนี้เป็นภาพหน้าร้านลูกค้า ระบบจะสร้างลิงก์ชั่วคราวอายุ 2 ชั่วโมงให้เอง
#
# ชื่อ STORAGE_* ไม่ผูกกับเจ้าใด ย้ายไป R2 / S3 / MinIO เปลี่ยนแค่ค่าพวกนี้
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="service-app"
