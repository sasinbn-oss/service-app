# From Supabase: click "Connect" on the project dashboard > ORM > Prisma.
# Copy both values exactly as shown there (they differ only in port/host).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-this-secret-in-production"
PORT=4000

# ที่เก็บรูปและวิดีโอที่ช่างแนบในใบงาน — ตอนนี้ใช้ Supabase Storage
# ถ้าไม่ใส่ ระบบอื่นทั้งหมดยังทำงานปกติ แค่แนบรูปในใบงานไม่ได้
#
# หาค่าได้จาก Supabase: Project Settings > Storage > S3 Connection
#   STORAGE_ENDPOINT = ค่า "Endpoint" ที่หน้านั้นแสดง
#   STORAGE_REGION   = ค่า "Region" ที่หน้านั้นแสดง (ต้องตรง ไม่งั้นลิงก์เปิดไฟล์จะใช้ไม่ได้)
#   คีย์สองตัว = กด "New access key" ที่หน้าเดียวกัน
#
# สร้างถังชื่อ service-app ที่เมนู Storage และ **อย่าติ๊ก Public bucket** —
# รูปพวกนี้เป็นภาพหน้าร้านลูกค้า ระบบจะสร้างลิงก์ชั่วคราวอายุ 2 ชั่วโมงให้เอง
#
# ชื่อ STORAGE_* ไม่ผูกกับเจ้าใด ย้ายไป R2 / S3 / MinIO เปลี่ยนแค่ค่าพวกนี้
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="service-app"
