generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's pgbouncer) for normal app queries.
  url       = env("DATABASE_URL")
  // Unpooled connection used only for running migrations.
  directUrl = env("DIRECT_URL")
}

// Roles/statuses are plain strings constrained by application code
// (see src/utils/constants.ts) rather than native Prisma enums, so the
// schema stays portable between database providers.

model User {
  id            Int             @id @default(autoincrement())
  employeeCode  String          @unique
  name          String
  phone         String?
  passwordHash  String
  role          String          @default("EMPLOYEE")
  createdAt     DateTime        @default(now())
  vehicleLogs   VehicleLog[]
  branchCheckIns BranchCheckIn[]
  workLogs      WorkLog[]
  consumableRequests ConsumableRequest[] @relation("RequestedBy")
  reviewedRequests   ConsumableRequest[] @relation("ReviewedBy")
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  plateNumber  String        @unique
  brand        String?
  model        String?
  type         String?
  status       String        @default("AVAILABLE")
  createdAt    DateTime      @default(now())
  logs         VehicleLog[]
}

model VehicleLog {
  id            Int               @id @default(autoincrement())
  vehicleId     Int
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  purpose       String
  destination   String?
  startMileage  Int
  endMileage    Int?
  startedAt     DateTime          @default(now())
  endedAt       DateTime?
  status        String            @default("ONGOING")
}

model Branch {
  id            Int             @id @default(autoincrement())
  name          String
  code          String          @unique
  address       String?
  latitude      Float
  longitude     Float
  radiusMeters  Int             @default(200)
  createdAt     DateTime        @default(now())
  checkIns      BranchCheckIn[]
  workLogs      WorkLog[]
}

model BranchCheckIn {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  latitude        Float
  longitude       Float
  distanceMeters  Float
  withinRadius    Boolean
  note            String?
  checkedInAt     DateTime @default(now())
}

model WorkLog {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  workDate        DateTime
  taskDescription String
  hoursSpent      Float?
  branchId        Int?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  createdAt       DateTime  @default(now())
}

model TroubleshootingGuide {
  id        Int      @id @default(autoincrement())
  category  String
  title     String
  symptom   String
  solution  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SparePart {
  id          Int      @id @default(autoincrement())
  partCode    String   @unique
  name        String
  brand       String?
  category    String?
  description String?
  // Either a full external URL, or a path served by this API
  // ("/api/spare-parts/:id/image") when a photo was uploaded.
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       SparePartImage?
}

// Uploaded photos live in their own table so listing parts never has to
// pull image bytes along with the row.
model SparePartImage {
  sparePartId Int       @id
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  mimeType    String
  data        Bytes
  updatedAt   DateTime  @updatedAt
}

model ConsumableItem {
  id           Int                     @id @default(autoincrement())
  name         String
  unit         String                  @default("ชิ้น")
  stockQty     Int                     @default(0)
  createdAt    DateTime                @default(now())
  requestItems ConsumableRequestItem[]
}

model ConsumableRequest {
  id           Int                     @id @default(autoincrement())
  userId       Int
  user         User                    @relation("RequestedBy", fields: [userId], references: [id])
  // PENDING | APPROVED | REJECTED — stock is deducted when a request is approved.
  status       String                  @default("PENDING")
  note         String?
  createdAt    DateTime                @default(now())
  reviewedById Int?
  reviewedBy   User?                   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  items        ConsumableRequestItem[]
}

model ConsumableRequestItem {
  id        Int               @id @default(autoincrement())
  requestId Int
  request   ConsumableRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    Int
  item      ConsumableItem    @relation(fields: [itemId], references: [id])
  quantity  Int
}
