generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's pgbouncer) for normal app queries.
  url       = env("DATABASE_URL")
  // Unpooled connection used only for running migrations.
  directUrl = env("DIRECT_URL")
}

// Roles/statuses are plain strings constrained by application code
// (see src/utils/constants.ts) rather than native Prisma enums, so the
// schema stays portable between database providers.

model User {
  id                   Int                   @id @default(autoincrement())
  employeeCode         String                @unique
  name                 String
  phone                String?
  passwordHash         String
  role                 String                @default("EMPLOYEE")
  // ภาคที่หัวหน้าภาคคนนี้ดูแล — ตรงกับ Branch.region
  //
  // ใช้เฉพาะกับ role SUPERVISOR เพื่อจำกัดว่าเห็นและจัดการใบงานของภาคไหน
  // แอดมินเห็นทุกภาคจึงไม่ต้องใส่ ช่างเห็นเฉพาะงานที่ถูกจ่ายให้ตัวเอง
  region               String?
  // ทีมช่างที่คนนี้สังกัด — ตรงกับ Branch.zone และ WorkOrder.assignedTeam
  //
  // ใช้กับ role EMPLOYEE เพื่อให้เห็นงานของทีมตัวเอง ว่าง = ยังไม่ได้จัดทีม
  // ซึ่งจะเห็นเฉพาะงานที่ถูกจ่ายให้ตัวเองแบบรายคนเหมือนเดิม
  team                 String?
  // ต้องเปลี่ยนรหัสก่อนใช้งาน
  //
  // ตั้งเป็น true ตอนแอดมินสร้างบัญชีให้ หรือตอนแอดมินตั้งรหัสใหม่ให้
  // เพราะรหัสตั้งต้นผ่านมือคนอื่นมาแล้ว จะถือว่าเป็นความลับของเจ้าของบัญชีไม่ได้
  mustChangePassword   Boolean               @default(false)
  createdAt            DateTime              @default(now())
  vehicleLogs          VehicleLog[]
  branchCheckIns       BranchCheckIn[]
  workLogs             WorkLog[]
  consumableRequests   ConsumableRequest[]   @relation("RequestedBy")
  reviewedRequests     ConsumableRequest[]   @relation("ReviewedBy")
  outageNotes          Outage[]
  outageNoteLogs       OutageNoteLog[]
  createdWorkOrders    WorkOrder[]           @relation("CreatedWorkOrders")
  assignedWorkOrders   WorkOrder[]           @relation("AssignedWorkOrders")
  closedWorkOrders     WorkOrder[]           @relation("ClosedWorkOrders")
  workOrderLogs        WorkOrderLog[]
  checkedParts         WorkOrderPart[]       @relation("CheckedWorkOrderParts")
  workOrderAttachments WorkOrderAttachment[]
  workedWorkOrders     WorkOrderWorker[]
  teamDayPlans         TeamDayPlan[]
  teamDayPlanSeats     TeamDayPlanMember[]
}

model Vehicle {
  id          Int          @id @default(autoincrement())
  plateNumber String       @unique
  brand       String?
  model       String?
  type        String?
  status      String       @default("AVAILABLE")
  createdAt   DateTime     @default(now())
  logs        VehicleLog[]
  dayPlans    TeamDayPlan[]
}

model VehicleLog {
  id           Int       @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  purpose      String
  destination  String?
  startMileage Int
  endMileage   Int?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  status       String    @default("ONGOING")
}

model Branch {
  id             Int             @id @default(autoincrement())
  name           String
  code           String          @unique
  address        String?
  // Optional because a branch can be on the machine dashboard long before
  // anyone has stood in it with a phone to record its coordinates. Check-in
  // only offers branches that have them.
  latitude       Float?
  longitude      Float?
  radiusMeters   Int             @default(200)
  // Grouping used by the machine dashboard.
  region         String?
  // COCO (company owned) | DODO (dealer owned)
  ownership      String?
  // ทีมช่างที่ดูแลสาขานี้สำหรับงาน CM — คอลัมน์ "ผู้ดูแล CM" ในไฟล์ทะเบียนสาขา
  //
  // ชื่อช่อง zone เป็นชื่อเดิมตั้งแต่ตอนที่แดชบอร์ดใช้จัดกลุ่ม ไม่ได้เปลี่ยนชื่อ
  // เพราะมีตัวกรองและรายงานหลายที่อ้างถึง zone อยู่ — ความหมายคือทีมช่าง
  //
  // ไฟล์ export รายงานเครื่องไม่มีค่านี้ ตัวนำเข้าจึงไม่แตะค่าเดิม เขียนทับให้ว่างไม่ได้
  zone           String?
  // ทีมช่างที่ดูแลงาน PM — คอลัมน์ "ผู้ดูแล PM" ในไฟล์ทะเบียนสาขา
  //
  // แยกจาก zone เพราะงาน PM กับงาน CM ไม่ได้เป็นของทีมเดียวกันเสมอไป
  // ว่างได้ — ในไฟล์จริงมีสาขาที่ช่องนี้ไม่ได้กรอก ตอนจ่ายงาน PM จะใช้ทีม CM แทน
  pmTeam         String?
  grade          String?
  // วันที่สาขาเปิดทำการ และวันที่ประกันหมด
  //
  // ประกันเป็นเรื่องของสาขาแฟรนไชส์เท่านั้น สาขาบริษัท (รหัสขึ้นต้นด้วย C)
  // ไม่มีประกันเพราะเครื่องเป็นของบริษัทเอง — ดู isCompanyBranch() ใน
  // src/utils/constants.ts
  //
  // ว่างได้ทั้งคู่ เพราะทะเบียนสาขาชุดเดิมไม่มีสองค่านี้ และจะทยอยเติมเข้ามา
  openedAt          DateTime?
  warrantyExpiresAt DateTime?
  // สถานะสาขาจาก CRM — active | inactive
  //
  // ห้ามใช้ช่องนี้เก็บ "สาขายกเลิก" เพราะตัวนำเข้ารายงานเครื่องเขียนทับทุกรอบ
  // จากคอลัมน์ status ในไฟล์ ซึ่งเป็น active เสมอ ใช้ cancelledAt แทน
  status         String?         @default("active")
  // สาขาที่เลิกกิจการแล้ว — ว่าง = ยังเปิดอยู่
  //
  // เครื่องของสาขาที่ปิดไปแล้วยังถูก export ออกมาเป็น state 0 ทุกรอบ
  // ถ้าไม่กันไว้ เคสจะเปิดค้างตลอดกาล สะสม SLA และคะแนนทั้งที่ไม่มีอะไรให้ซ่อม
  cancelledAt    DateTime?
  cancelledNote  String?
  createdAt      DateTime        @default(now())
  checkIns       BranchCheckIn[]
  workLogs       WorkLog[]
  machines       Machine[]
  outages        Outage[]
  scoreSnapshots ScoreSnapshot[]
  workOrders     WorkOrder[]
}

// One washer or dryer installed at a branch.
model Machine {
  id          Int         @id @default(autoincrement())
  branchId    Int
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // Label on the machine itself, e.g. W3 (washer) or D12 (dryer).
  code        String
  // WASHER | DRYER
  type        String
  // ON | OFF — สรุปสถานะล่าสุด เก็บไว้เพื่อความสะดวกในการค้น
  // ส่วนเวลาที่ใช้คิด SLA อยู่ที่ Outage ซึ่งเป็นตัวจริง
  status      String      @default("ON")
  brand       String?
  // รุ่นของเครื่อง เช่น HC60 — ไฟล์ export ไม่มีมาให้ คนกรอกตอนเปิดใบงาน
  // เก็บไว้ที่เครื่อง ไม่ใช่ที่ใบงาน เพราะรุ่นเป็นของตัวเครื่อง ไม่ได้เปลี่ยนไปตามงาน
  // กรอกครั้งเดียวแล้วครั้งต่อไปขึ้นให้เอง ไม่ต้องถามซ้ำทุกใบ
  model       String?
  // ขนาดเครื่องเป็นกิโลกรัม เช่น 10 13 18 — ไฟล์ export ไม่มีมาให้เหมือนรุ่น
  //
  // เก็บเป็นตัวเลขไม่ใช่ข้อความอย่าง "10 kg" เพราะต้องเอาไปจัดกลุ่มและเรียงได้
  // ว่าขนาดไหนเสียบ่อย ถ้าเก็บเป็นข้อความจะได้ "10kg" "10 กก." "10" ปนกัน
  // จนรวมยอดไม่ได้ หน่วยเป็น kg ตายตัวทั้งระบบ จึงไม่ต้องเก็บหน่วยไปด้วย
  capacityKg  Int?
  // ค่า state ดิบจากไฟล์ export — 0 คือเครื่องดับ ค่าอื่นข้ามตามที่ตกลงกัน
  stateCode   String?
  // เครื่องที่ถอดออกไปแล้ว — ว่าง = ยังติดตั้งอยู่
  //
  // เหมือน Branch.cancelledAt แต่ระดับเครื่อง สำหรับสาขาที่ยังเปิดอยู่
  // แต่ถอดเครื่องออกบางตัว ซึ่งเจอบ่อยกว่าปิดทั้งสาขา
  removedAt   DateTime?
  removedNote String?
  updatedAt   DateTime    @updatedAt
  outages     Outage[]
  workOrders  WorkOrder[]

  @@unique([branchId, code])
  @@index([status])
}

// หนึ่งเคสของปัญหา ตั้งแต่เห็นครั้งแรกจนหายไปจากไฟล์
//
// ไฟล์ export บอกแค่ว่า "ตอนนี้ใครมีปัญหา" ไม่ได้บอกว่าเริ่มเมื่อไหร่
// ระบบจึงต้องจำเอง: เจอในไฟล์ครั้งแรก = เปิดเคส, หายไปจากไฟล์ = ปิดเคส
// เวลาที่ค้างอยู่ระหว่างนั้นคือ SLA และเคสที่ปิดแล้วกลายเป็นประวัติสำหรับทำรายงาน
model Outage {
  id          Int       @id @default(autoincrement())
  // MACHINE_OFF (เครื่องดับ รายเครื่อง) | SIGNAL_LOST (สัญญาณหาย ทั้งสาขา)
  kind        String
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // ว่างสำหรับ SIGNAL_LOST เพราะเป็นปัญหาระดับสาขา ไม่ใช่ของเครื่องใดเครื่องหนึ่ง
  machineId   Int?
  machine     Machine?  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  // snapshot ล่าสุดที่ยังเห็นปัญหานี้ ใช้บอกว่าของจริงหายไปช่วงไหน
  lastSeenAt  DateTime
  // ว่าง = ยังไม่หาย เคสที่เปิดอยู่คือสิ่งที่แดชบอร์ดแสดง
  endedAt     DateTime?
  // ทำไมถึงปิด — ดูค่าที่ใช้ได้ที่ CLOSE_REASONS ใน src/utils/constants.ts
  //
  // ต้องแยก "ซ่อมเสร็จ" ออกจาก "สาขาปิด/ถอดเครื่อง" ไม่งั้นเครื่องที่ค้างมา 40 วัน
  // แล้วสาขาปิด จะถูกนับเป็นงานซ่อมที่ใช้เวลา 40 วัน แล้วค่าเฉลี่ยในรายงานเพี้ยนถาวร
  // ว่าง = เคสเก่าที่ปิดก่อนมีช่องนี้ ถือว่าซ่อมเสร็จตามเดิม
  closeReason String?

  // สิ่งที่คนกรอกเอง ไฟล์ export ไม่มีให้ — บอกว่าเสียเพราะอะไรและติดอยู่ที่ขั้นไหน
  // ผูกกับเคส ไม่ใช่กับเครื่อง เคสใหม่จึงเริ่มจากว่างเสมอ ไม่เอาอาการเก่ามาปน
  symptom          String?
  // ดูค่าที่ใช้ได้ที่ WORK_STATUSES ใน src/utils/constants.ts
  workStatus       String?
  // วันที่ช่างนัดเข้าไปแก้ ใช้ตอน workStatus = WAITING_TECH
  // เก็บเป็นวันที่อย่างเดียว ไม่มีเวลา เพราะนัดกันเป็นวัน
  scheduledVisitAt DateTime?
  noteUpdatedAt    DateTime?
  noteUpdatedById  Int?
  noteUpdatedBy    User?           @relation(fields: [noteUpdatedById], references: [id])
  // อะไหล่ที่เคสนี้รออยู่ ใช้ตอน workStatus = WAITING_PARTS
  parts            OutagePart[]
  noteLogs         OutageNoteLog[]
  workOrders       WorkOrder[]

  @@index([kind, endedAt])
  @@index([branchId, endedAt])
}

// ประวัติว่าใครมากรอกอาการ/สถานะของเคสไหน เมื่อไหร่
//
// ฟิลด์ noteUpdatedBy บน Outage บอกได้แค่คนล่าสุด พอมีคนแก้ทับก็ไม่เหลือร่องรอย
// ว่าก่อนหน้าใครเคยกรอกอะไรไว้ ตารางนี้เก็บทุกครั้งที่กดบันทึกแยกไว้ต่างหาก
//
// เก็บเป็น snapshot ของค่าหลังบันทึก ไม่ใช่ส่วนต่าง เพราะอ่านย้อนหลังแล้วเข้าใจ
// ได้ทันทีว่าตอนนั้นเคสอยู่ในสภาพไหน โดยไม่ต้องไล่ประกอบจากรายการก่อนหน้า
model OutageNoteLog {
  id       Int    @id @default(autoincrement())
  outageId Int
  outage   Outage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  // ว่างได้เผื่อผู้ใช้ถูกลบทีหลัง ประวัติยังต้องอยู่
  userId   Int?
  user     User?  @relation(fields: [userId], references: [id])

  symptom          String?
  workStatus       String?
  scheduledVisitAt DateTime?
  // สรุปอะไหล่เป็นข้อความ เช่น "SPOS0002 x8, CB-0305" เก็บ ณ ตอนนั้นเลย
  // ไม่ผูก relation เพราะถ้าอะไหล่ถูกลบทีหลัง ประวัติต้องยังอ่านออก
  partsSummary     String?

  createdAt DateTime @default(now())

  @@index([outageId, createdAt])
  @@index([createdAt])
}

// อะไหล่ที่เคสหนึ่งรออยู่
//
// ชี้ไปที่ SparePart แทนที่จะให้พิมพ์รหัสเอง เพราะรหัสที่พิมพ์มือจะสะกดไม่ตรงกัน
// แล้วรวมยอดว่าทั้งประเทศค้างอะไหล่ตัวไหนอยู่กี่ตัวไม่ได้
model OutagePart {
  id          Int       @id @default(autoincrement())
  outageId    Int
  outage      Outage    @relation(fields: [outageId], references: [id], onDelete: Cascade)
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  quantity    Int       @default(1)

  // อะไหล่ตัวเดิมในเคสเดียวกันมีได้แถวเดียว เพิ่มซ้ำให้ไปบวกจำนวนแทน
  @@unique([outageId, sparePartId])
  @@index([sparePartId])
}

// บันทึกการอัปโหลดแต่ละครั้ง ไว้ดูย้อนหลังว่าตัวเลขที่เปลี่ยนมาจากไฟล์ไหน
model MachineImport {
  id                 Int             @id @default(autoincrement())
  uploadedById       Int?
  fileName           String?
  // เวลาของ snapshot ที่ใช้เป็นจุดอ้างอิงในการเปิด/ปิดเคส
  snapshotAt         DateTime
  rowsInFile         Int
  duplicateRows      Int
  branchesTouched    Int
  machinesOff        Int
  branchesSignalLost Int
  opened             Int
  closed             Int
  // คะแนนรวม ณ ตอนนั้น เก็บซ้ำไว้ตรงนี้ด้วยเพื่อดึงกราฟแนวโน้มได้ด้วยคิวรีเดียว
  // โดยไม่ต้องรวมยอดจาก ScoreSnapshot ทีละรอบ
  machineOffScore    Int             @default(0)
  signalLostScore    Int             @default(0)
  totalScore         Int             @default(0)
  createdAt          DateTime        @default(now())
  scoreSnapshots     ScoreSnapshot[]
}

// คะแนนของแต่ละสาขา ณ ตอนที่อัปโหลดไฟล์แต่ละรอบ
//
// คะแนนบนแดชบอร์ดคิดสดจากเวลาปัจจุบัน พอเคสปิดไปคะแนนก็หายไปด้วย
// ตารางนี้ตรึงค่าไว้ทุกรอบอัปโหลด จึงย้อนดูได้ว่าสัปดาห์ที่แล้วภาคไหนหนักกว่ากัน
//
// เก็บภาค/ทีมช่าง/เจ้าของ ณ ตอนนั้นติดไปด้วย ไม่ได้อ้างอิงค่าปัจจุบันของสาขา
// เพราะถ้าอัปโหลดทะเบียนสาขาใหม่แล้วสาขาย้ายภาค รายงานย้อนหลังต้องไม่เปลี่ยนตาม
model ScoreSnapshot {
  id         Int            @id @default(autoincrement())
  importId   Int?
  import     MachineImport? @relation(fields: [importId], references: [id], onDelete: Cascade)
  snapshotAt DateTime

  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  region    String?
  zone      String?
  ownership String?
  grade     String?

  // MACHINE_OFF | SIGNAL_LOST — แยกกันเพราะคนละทีมรับผิดชอบและคะแนนต่อวันไม่เท่ากัน
  kind     String
  cases    Int
  score    Int
  breached Int

  @@unique([importId, branchId, kind])
  @@index([snapshotAt])
  @@index([branchId, snapshotAt])
}

model BranchCheckIn {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  branchId       Int
  branch         Branch   @relation(fields: [branchId], references: [id])
  latitude       Float
  longitude      Float
  distanceMeters Float
  withinRadius   Boolean
  note           String?
  checkedInAt    DateTime @default(now())
}

model WorkLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  workDate        DateTime
  taskDescription String
  hoursSpent      Float?
  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  createdAt       DateTime @default(now())
}

model TroubleshootingGuide {
  id        Int      @id @default(autoincrement())
  category  String
  title     String
  symptom   String
  solution  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An interactive diagnostic tree imported from a manufacturer flowchart.
// Technicians answer ใช่/ไม่ at each node until they reach a fix.
model TroubleshootFlow {
  id          Int                 @id @default(autoincrement())
  title       String
  machineType String?
  notes       String?
  // Key of the node the technician starts at.
  rootKey     String?
  sourceFile  String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  nodes       TroubleshootNode[]
  images      TroubleshootImage[]
}

model TroubleshootNode {
  id         Int              @id @default(autoincrement())
  flowId     Int
  flow       TroubleshootFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  // Stable identifier used by yesKey/noKey; unique within a flow.
  key        String
  // QUESTION | ACTION
  kind       String
  text       String
  // Marker such as "(1)" cross-referencing the wiring diagrams.
  stepNumber String?
  yesKey     String?
  noKey      String?
  order      Int              @default(0)

  @@unique([flowId, key])
}

model TroubleshootImage {
  id       Int              @id @default(autoincrement())
  flowId   Int
  flow     TroubleshootFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  mimeType String
  data     Bytes
  order    Int              @default(0)
}

model SparePart {
  id             Int             @id @default(autoincrement())
  partCode       String          @unique
  name           String
  brand          String?
  category       String?
  description    String?
  // Either a full external URL, or a path served by this API
  // ("/api/spare-parts/:id/image") when a photo was uploaded.
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  image          SparePartImage?
  outageParts    OutagePart[]
  workOrderParts WorkOrderPart[]
}

// Uploaded photos live in their own table so listing parts never has to
// pull image bytes along with the row.
model SparePartImage {
  sparePartId Int       @id
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  mimeType    String
  data        Bytes
  updatedAt   DateTime  @updatedAt
}

model ConsumableItem {
  id           Int                     @id @default(autoincrement())
  name         String
  unit         String                  @default("ชิ้น")
  stockQty     Int                     @default(0)
  createdAt    DateTime                @default(now())
  requestItems ConsumableRequestItem[]
}

model ConsumableRequest {
  id           Int                     @id @default(autoincrement())
  userId       Int
  user         User                    @relation("RequestedBy", fields: [userId], references: [id])
  // PENDING | APPROVED | REJECTED — stock is deducted when a request is approved.
  status       String                  @default("PENDING")
  note         String?
  createdAt    DateTime                @default(now())
  reviewedById Int?
  reviewedBy   User?                   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  items        ConsumableRequestItem[]
}

model ConsumableRequestItem {
  id        Int               @id @default(autoincrement())
  requestId Int
  request   ConsumableRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    Int
  item      ConsumableItem    @relation(fields: [itemId], references: [id])
  quantity  Int
}

// ใบงานซ่อม — สิ่งที่ช่างถือไปทำ ต่างจาก Outage ที่เป็นสภาพของเครื่อง
//
// Outage เปิดและปิดตามไฟล์ export เท่านั้น คนสั่งปิดเองไม่ได้ เพราะไฟล์คือความจริง
// ว่าเครื่องกลับมาหรือยัง ส่วนใบงานเป็นเรื่องของคน — ใครรับ ไปเมื่อไหร่ ทำอะไรไป
// สองอย่างนี้จึงปิดคนละเวลาได้ ปิดใบงานแล้วเครื่องยังไม่กลับมาก็เป็นไปได้
// และต้องเห็นด้วยว่าเป็นแบบนั้น
model WorkOrder {
  id     Int    @id @default(autoincrement())
  // รหัสที่คนอ่าน เช่น WO-00042 — ตั้งจาก id หลังสร้าง จึงไม่มีทางชนกัน
  code   String @unique
  // OUTAGE (เปิดจากกระดานติดตาม) | MANUAL (เปิดเอง)
  source String @default("MANUAL")

  // เคสที่เป็นต้นเรื่อง ว่างได้เพราะใบงานที่เปิดเองไม่ได้มาจากเคสไหน
  outageId  Int?
  outage    Outage?  @relation(fields: [outageId], references: [id], onDelete: SetNull)
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // ว่างเมื่อเป็นงานระดับสาขา เช่น สัญญาณหาย ซึ่งไม่ได้เจาะจงเครื่องไหน
  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  // ประเภทงาน — ดูค่าที่ใช้ได้ที่ JOB_TYPES ใน src/utils/constants.ts
  jobType String  @default("CM")
  title   String
  detail  String?

  // ── อาการและสถานะ — ที่เดียวกับที่เคยกรอกบนกระดาน ──
  //
  // อยู่ที่ใบงานเพราะคนที่รู้คือช่างที่ถือใบงานไป ไม่ใช่คนที่นั่งดูกระดาน
  // กระดานยังแสดงค่าเหล่านี้อยู่ แต่ดึงจากใบงานแทนที่จะให้กรอกซ้ำอีกที่
  //
  // ค่าที่กรอกที่นี่ถูกคัดลอกไปไว้ที่ Outage ด้วย เพื่อให้ตัวกรอง รายงาน
  // และประวัติที่อ่านจากเคสอยู่แล้วทำงานต่อได้โดยไม่ต้องรื้อ
  // คนที่สาขาให้ติดต่อเรื่องใบงานนี้ กรอกตอนเปิดใบงาน
  //
  // เก็บที่ใบงานไม่ใช่ที่สาขา เพราะคนเฝ้าร้านเปลี่ยนตามกะและตามช่วง
  // เบอร์ที่ใช้ได้เมื่อสามเดือนก่อนไม่ได้แปลว่าวันนี้โทรไปแล้วเจอคนเดิม
  contactName  String?
  contactPhone String?

  symptom    String?
  // ดูค่าที่ใช้ได้ที่ WORK_STATUSES ใน src/utils/constants.ts — ชุดเดียวกับของเคส
  workStatus String?
  // ดูค่าที่ใช้ได้ที่ WORK_ORDER_PRIORITIES ใน src/utils/constants.ts
  priority   String  @default("NORMAL")
  // ขั้นที่ใบงานเดินไปถึง — ดูค่าที่ใช้ได้ที่ WORK_ORDER_STATUSES
  //
  // เดินทีละขั้นตามสายงานจริง: แอดมินเปิดเรื่อง → หัวหน้าภาคระบุอะไหล่ →
  // แอดมินเช็คคลัง → หัวหน้าภาคจ่ายงาน → ช่างนัดวัน → ช่างปิดงาน
  // ข้ามขั้นไม่ได้ ไม่งั้นจะมีใบที่จ่ายให้ช่างทั้งที่ยังไม่รู้ว่ามีอะไหล่หรือเปล่า
  status     String  @default("NEW")

  // งานนี้ต้องใช้อะไหล่ไหม — หัวหน้าภาคเป็นคนตัดสินในขั้นที่ 2
  //
  // ว่าง = ยังไม่ได้ตัดสิน · true = ต้องใช้ ไปให้แอดมินเช็คคลังต่อ
  // false = ไม่ใช้ ข้ามขั้นเช็คคลังไปจัดคิวช่างเลย เช่น เข้าไปประเมินอาการก่อน
  needsParts Boolean?

  // ทีมช่างที่รับงานนี้ — ตรงกับ Branch.zone ซึ่งมาจากคอลัมน์ "ทีมช่าง" ในไฟล์ทะเบียนสาขา
  //
  // งานถูกจ่ายให้ "ทีม" ไม่ใช่ "คน" เพราะทีมเป็นหน่วยที่รับผิดชอบสาขาจริง
  // ส่วนใครไปจริงในวันนั้นเป็นเรื่องที่รู้ตอนปิดงาน ไม่ใช่ตอนจ่ายงาน
  assignedTeam String?
  // ช่างที่ถูกจ่ายงานให้แบบรายคน — ของใบงานเก่าก่อนเปลี่ยนมาจ่ายเป็นทีม
  //
  // ไม่ได้เขียนค่าใหม่แล้ว แต่ยังอ่านอยู่ เพื่อให้ใบที่ค้างอยู่ตอนเปลี่ยนระบบ
  // ยังอยู่ในมือคนเดิม ไม่ใช่หายไปจากรายการของเขาทั้งที่ยังทำไม่เสร็จ
  assignedToId Int?
  assignedTo   User?     @relation("AssignedWorkOrders", fields: [assignedToId], references: [id])
  // วันที่นัดเข้าไปทำ เก็บเป็นวันอย่างเดียว เพราะนัดกันเป็นวัน
  scheduledAt  DateTime?
  // เวลานัด "HH:MM" แยกจากวัน — ใบเก่านัดกันเป็นวันอย่างเดียว ว่างจึงแปลว่า
  // "ทั้งวัน" ไม่ใช่เที่ยงคืน ถ้ารวมไว้ในช่องเดียวกันจะแยกสองอย่างนี้ไม่ออก
  scheduledTime String?
  // ลูกค้ารับนัดหรือยัง — PENDING รอคอนเฟิร์ม · CONFIRMED ลูกค้าคอนเฟิร์ม
  // ADMIN_PICKED ลูกค้าสะดวกทุกวัน แอดมินเลือกวันให้ (ดู APPOINTMENT_STATUSES)
  appointmentStatus String?

  // ── ตรวจหน้างาน ──
  // หัวหน้าภาคระบุอะไหล่ไม่ได้จนกว่าจะมีคนไปดู — ผลตรวจเก็บไว้ที่ใบงาน
  // เพราะคนที่ระบุอะไหล่รอบถัดไปต้องอ่านมันตอนตัดสินใจ ไม่ใช่ไปค้นในประวัติ
  inspectedAt    DateTime?
  inspectionNote String?

  // ใบงานรออะไหล่ที่แยกออกมาจากใบนี้ — อะไหล่บางตัวหมด หรือไปแล้วเปลี่ยนไม่ครบ
  //
  // เป็นใบใหม่ไม่ใช่สถานะของใบเดิม เพราะของที่มีอยู่ซ่อมได้เลย ไม่ควรถูกกั้น
  // ด้วยของที่ยังไม่มา แต่ต้องลิงก์กันไว้ ไม่งั้นดูไม่ออกว่าเป็นงานเดียวกัน
  parentId Int?
  parent   WorkOrder?  @relation("WorkOrderSplit", fields: [parentId], references: [id], onDelete: SetNull)
  children WorkOrder[] @relation("WorkOrderSplit")

  createdById Int?
  createdBy   User?    @relation("CreatedWorkOrders", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── ปิดงาน ──
  closedAt    DateTime?
  closedById  Int?
  closedBy    User?     @relation("ClosedWorkOrders", fields: [closedById], references: [id])
  // ผลของงาน ไม่ใช่แค่ "ปิดแล้ว" — ดู WORK_ORDER_RESULTS ใน src/utils/constants.ts
  closeResult String?
  closeNote   String?
  // คนนอกระบบที่ไปด้วย เช่น ช่างผู้รับเหมาหรือคนของสาขา
  //
  // มีไว้เพราะคนที่ไปหน้างานจริงไม่ได้มีบัญชีในระบบทุกคน และถ้าไม่มีช่องให้กรอก
  // ชื่อเหล่านั้นจะไปโผล่ในช่องสรุปงานแทน ซึ่งค้นหาไม่ได้
  closeOtherWorkers String?

  parts       WorkOrderPart[]
  logs        WorkOrderLog[]
  attachments WorkOrderAttachment[]
  workers     WorkOrderWorker[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([assignedTeam, status])
  @@index([outageId])
  @@index([scheduledAt])
  @@index([parentId])
}

// คนที่เข้าไปทำงานจริง บันทึกตอนปิดงาน
//
// แยกเป็นตารางไม่ใช่ข้อความ เพราะต้องนับย้อนได้ว่าใครไปกี่งาน ซึ่งเป็นคำถาม
// ที่จะถูกถามแน่ ๆ เมื่อจ่ายงานเป็นทีม — ชื่อที่เก็บเป็นข้อความรวมกันนับไม่ได้
model WorkOrderWorker {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workOrderId, userId])
  @@index([userId])
}

// อะไหล่ที่ใช้จริงตอนปิดงาน ต่างจาก OutagePart ที่เป็นของที่ "รออยู่"
model WorkOrderPart {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  // WAITING (รออะไหล่ตัวนี้อยู่) | USED (ใช้ไปจริงตอนปิดงาน)
  //
  // สองอย่างนี้ต่างกันจริง ของที่รอกับของที่ใช้ไม่จำเป็นต้องตรงกัน ช่างอาจไปถึง
  // แล้วพบว่าเสียคนละจุด ถ้าเก็บรวมกันจะแยกไม่ออกว่ายอดที่ต้องสั่งซื้อคือเท่าไหร่
  kind        String    @default("USED")

  // ── ผลการเช็คคลัง เฉพาะของที่ kind = WAITING ──
  //
  // ว่าง = ยังไม่มีใครเช็ค · true = มีของ พร้อมบอกว่าอยู่คลังไหน · false = หมด
  // ถ้ามีตัวไหน false ใบงานจะขึ้นสถานะ "รออะไหล่" ให้เอง
  inStock     Boolean?
  // ชื่อคลังที่มีของ ตามรายชื่อใน src/documents/warehouses.ts
  warehouse   String?
  // เลขใบเบิกอะไหล่จากระบบคลัง — พิมพ์เอง ไม่ได้ออกเลขให้เอง
  //
  // เก็บรายตัวไม่ใช่รายใบงาน เพราะใบงานที่ช่างส่งกลับมาขอเบิกเพิ่มจะมีใบเบิก
  // ใบที่สอง ถ้าเก็บไว้ที่ใบงานใบเดียว เลขใบแรกจะถูกทับหายไป
  requisitionNo String?
  checkedAt   DateTime?
  checkedById Int?
  checkedBy   User?     @relation("CheckedWorkOrderParts", fields: [checkedById], references: [id])

  @@unique([workOrderId, sparePartId, kind])
}

// ประวัติทุกครั้งที่ใบงานเปลี่ยนมือหรือเปลี่ยนสถานะ
//
// เหมือน OutageNoteLog — ช่องบนใบงานบอกได้แค่สภาพล่าสุด พอมีคนแก้ทับ
// ก็ไม่เหลือร่องรอยว่าใครทำอะไรไว้ก่อนหน้า
model WorkOrderLog {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?     @relation(fields: [userId], references: [id])
  // CREATED | ASSIGNED | STARTED | CLOSED | CANCELLED | REOPENED | EDITED
  action      String
  // สภาพหลังทำรายการนี้ เก็บเป็น snapshot เพื่ออ่านย้อนหลังแล้วเข้าใจได้ทันที
  status      String
  note        String?
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

// รูปหรือวิดีโอที่แนบมากับใบงาน
//
// ไฟล์จริงอยู่บนที่เก็บไฟล์ภายนอก (Supabase Storage) ไม่ได้อยู่ในฐานข้อมูลนี้
// เพราะวิดีโอคลิปเดียว 1 นาทีใหญ่กว่าข้อมูลทั้งระบบรวมกันหลายเท่า และพื้นที่
// ฐานข้อมูลแพงกว่าพื้นที่เก็บไฟล์มาก — ที่นี่เก็บแค่ที่อยู่ของไฟล์กับรูปย่อ
//
// รูปย่อเก็บไว้ที่นี่โดยตั้งใจ (ไม่กี่สิบ KB) เพราะถ้าเก็บแต่ที่อยู่ หน้าใบงานจะเห็น
// แค่ตัวหนังสือ หัวหน้าภาคที่ไล่ดูยี่สิบใบต้องกดเปิดทีละใบยี่สิบครั้ง
// และถ้าวันหนึ่งไฟล์ในถังถูกย้ายหรือลบ อย่างน้อยยังเหลือภาพให้รู้ว่าเคยมีอะไร
model WorkOrderAttachment {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // IMAGE | VIDEO — ดูที่ ATTACHMENT_KINDS ใน src/utils/constants.ts
  kind      String
  // NAMEPLATE = รูปป้ายรุ่นที่ติดอยู่บนเครื่อง · ว่าง = รูปหน้างานทั่วไป
  //
  // แยกไว้เพราะสองอย่างนี้ถูกใช้คนละแบบ — รูปหน้างานคือหลักฐานว่าเจออะไร
  // ส่วนรูปป้ายรุ่นคือที่มาของรุ่นเครื่องที่กรอกไว้ เอาไว้ย้อนดูตอนสงสัยว่า
  // ใส่รุ่นถูกหรือเปล่า ปนกันแล้วหาไม่เจอ
  role      String?
  fileName  String
  mimeType  String
  sizeBytes Int

  // ── ที่อยู่ของไฟล์จริงในถัง ──
  //
  // เก็บเป็น key ในถัง (เช่น work-orders/WO-2026-0001/17590000-photo.jpg)
  // ไม่ได้เก็บเป็น URL เพราะถังไม่ได้เปิดสาธารณะ — รูปในนี้เป็นภาพหน้าร้านลูกค้า
  // เวลาจะดูต้องขอลิงก์ชั่วคราวจากเซิร์ฟเวอร์ทีละครั้ง ลิงก์หมดอายุใน 2 ชั่วโมง
  objectKey  String?
  // ว่าง = อัปขึ้นที่เก็บไม่สำเร็จ ยังเหลือแต่รูปย่อ ให้ลองใหม่ได้
  uploadedAt DateTime?

  // รูปย่อ ~20 KB เก็บที่นี่เพื่อให้ใบงานแสดงภาพได้โดยไม่ต้องขอลิงก์ทีละรูป
  thumbnail Bytes?

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([workOrderId, createdAt])
}

// แผนของทีมหนึ่งในวันหนึ่ง — ใครไปกับใคร รถคันไหน ใครเป็นคนจัด
//
// ไม่ได้เก็บว่าไปที่ไหนบ้าง เพราะนั่นคือใบงานที่นัดวันนั้นของทีมนั้นอยู่แล้ว
// เก็บซ้ำไว้ที่นี่จะได้ความจริงสองชุดที่วันหนึ่งไม่ตรงกัน — แก้วันนัดในใบงาน
// แล้วบอร์ดยังโชว์วันเดิม ตารางนี้เก็บเฉพาะสิ่งที่ใบงานไม่รู้
model TeamDayPlan {
  id          Int                 @id @default(autoincrement())
  // วันอย่างเดียว เก็บที่เที่ยงคืน UTC แบบเดียวกับ WorkOrder.scheduledAt
  date        DateTime
  team        String
  vehicleId   Int?
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  note        String?
  plannedById Int?
  plannedBy   User?               @relation(fields: [plannedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime            @updatedAt
  members     TeamDayPlanMember[]

  @@unique([date, team])
}

model TeamDayPlanMember {
  id     Int         @id @default(autoincrement())
  planId Int
  plan   TeamDayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId Int
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // คนแรกที่เลือกคือหัวหน้าทีมของวันนั้น
  position Int       @default(0)

  @@unique([planId, userId])
}
