generator client {
  provider        = "prisma-client-js"
  // ดึงตารางที่เกี่ยวข้อง (สาขา เครื่อง อะไหล่ ฯลฯ) ใน SQL คำสั่งเดียวแทนคำสั่งละตาราง
  // ฐานข้อมูลจริงอยู่คนละ region (ไปกลับ ~220 ms) — หน้าใบงานเคยรอ 12 รอบต่อกัน
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's pgbouncer) for normal app queries.
  url       = env("DATABASE_URL")
  // Unpooled connection used only for running migrations.
  directUrl = env("DIRECT_URL")
}

// Roles/statuses are plain strings constrained by application code
// (see src/utils/constants.ts) rather than native Prisma enums, so the
// schema stays portable between database providers.

model User {
  id                   Int                   @id @default(autoincrement())
  employeeCode         String                @unique
  name                 String
  phone                String?
  passwordHash         String
  role                 String                @default("EMPLOYEE")
  // ภาคที่หัวหน้าภาคคนนี้ดูแล (ภาคแรก) — ตรงกับ Branch.region
  //
  // ใช้เฉพาะกับ role SUPERVISOR เพื่อจำกัดว่าเห็นและจัดการใบงานของภาคไหน
  // แอดมินเห็นทุกภาคจึงไม่ต้องใส่ ช่างเห็นเฉพาะงานที่ถูกจ่ายให้ตัวเอง
  // ภาคที่สองขึ้นไปอยู่ใน extraRegions — ภาคทั้งหมดของคนหนึ่งอ่านผ่าน regionsOf (utils/supervisorScope.ts)
  region               String?
  // ภาคที่ดูแลเพิ่มจาก region (เจ้าของงานขอ ต.ค. 69: หัวหน้าภาคคนเดียวเลือกได้หลายภาค)
  //
  // ทุกภาคได้สิทธิ์เต็มเท่าภาคแรก (เห็น ทำ เข้ากล่องงาน) · สองคนถือภาคเดียวกันได้ ใบเข้ากล่องทั้งคู่
  // แยกคอลัมน์แทนการเปลี่ยน region เป็น array เพราะเทสต์กว่า 40 ไฟล์และไฟล์สำรองเก่าเขียน/อ่าน region ตรง ๆ
  // — เปลี่ยนชนิดแล้วไฟล์สำรองเก่ากู้กลับมาหัวหน้าภาคทุกคนจะไม่มีภาคเลยโดยไม่มีใครรู้
  extraRegions         String[]              @default([])
  // ทีมช่างที่คนนี้สังกัด — ตรงกับ Branch.zone และ WorkOrder.assignedTeam
  //
  // ใช้กับ role EMPLOYEE เพื่อให้เห็นงานของทีมตัวเอง ว่าง = ยังไม่ได้จัดทีม
  // ซึ่งจะเห็นเฉพาะงานที่ถูกจ่ายให้ตัวเองแบบรายคนเหมือนเดิม
  // Senior ช่าง: ทีม/ทีมรวมที่เลือกเป็นอันแรก ที่เหลืออยู่ใน extraTeams
  team                 String?
  // ทีมช่าง/ทีมรวมที่ Senior ช่างดูแลเพิ่มจาก team (เจ้าของงานขอ ต.ค. 69: Senior ดูได้หลายสังกัดและหลายทีม)
  //
  // อ่านเฉพาะตอน role = SENIOR_TECH ผ่าน teamsOf (utils/teamGroups.ts) — ขอบเขตช่างคิดให้ทุกคนที่ไม่ใช่แอดมิน/หัวหน้าภาค
  // ถ้าอ่านทุก role ค่าค้างของคนที่ถูกลดเป็นช่างธรรมดาจะกลายเป็นสิทธิ์เห็นงานหลายทีมโดยไม่มีใครตั้งให้
  // แยกคอลัมน์แทนการเปลี่ยน team เป็น array ด้วยเหตุผลเดียวกับ extraRegions (เทสต์/ไฟล์สำรองเก่าอ่านเขียน team ตรง ๆ)
  extraTeams           String[]              @default([])
  // ทีมช่างที่หัวหน้าภาคคนนี้ดูแล — ตรงกับ Branch.zone / Branch.pmTeam / WorkOrder.assignedTeam
  //
  // บันทึกแบ่งทีม 4 ต.ค. 69 แบ่งหัวหน้าภาคตามทีม ไม่ตรงกับภาคในทะเบียนสาขา
  // (สองคนแบ่ง กทม. กันตามเขต · คนหนึ่งดูสองภาค · คนหนึ่งดู OPL) ภาคเดียวต่อคนจึงไม่พอ
  // (ภายหลังเลือกได้หลายภาคแล้วผ่าน extraRegions แต่การแบ่งตามเขต/ทีม OPL ยังต้องใช้ทีม)
  // ขอบเขตของหัวหน้าภาค = สาขาในทุกภาค (region + extraRegions) รวมกับสาขา/ใบงานของทีมเหล่านี้
  supervisedTeams      String[]              @default([])
  // Area ที่ Supervisor (COCO) คนนี้อยู่ใต้ — จากคอลัมน์ Area ในไฟล์ Area Team
  //
  // ใช้แค่แสดงผลและออกรายงาน (คอลัมน์ Area) ไม่ได้ใช้คุมสิทธิ์ — Area เห็นสาขา COCO ทั้งหมดอยู่แล้ว
  // ไม่ใช่เฉพาะของลูกทีมตัวเอง (เจ้าของงานกำหนด ต.ค. 69)
  areaId               Int?
  area                 User?                 @relation("AreaMembers", fields: [areaId], references: [id], onDelete: SetNull)
  areaMembers          User[]                @relation("AreaMembers")
  cocoBranches         Branch[]              @relation("CocoSupervisor")
  // Maid (COCO) — สาขาที่ประจำอยู่ (เจ้าของงานเพิ่ม ต.ค. 69) · แยกจาก cocoBranches เพราะสาขาหนึ่งมีทั้ง Supervisor และ Maid
  maidBranches         CocoMaidBranch[]      @relation("CocoMaid")
  coveredBranches      Branch[]              @relation("CoverFor")
  usageSlots           UsageSlot[]
  // ต้องเปลี่ยนรหัสก่อนใช้งาน
  //
  // ตั้งเป็น true ตอนแอดมินสร้างบัญชีให้ หรือตอนแอดมินตั้งรหัสใหม่ให้
  // เพราะรหัสตั้งต้นผ่านมือคนอื่นมาแล้ว จะถือว่าเป็นความลับของเจ้าของบัญชีไม่ได้
  mustChangePassword   Boolean               @default(false)
  // เปลี่ยน/รีเซ็ตรหัสผ่านล่าสุด — โทเคนที่ออกก่อนเวลานี้ใช้ไม่ได้ (มือถือหาย คนลาออกแต่ยังล็อกอินค้าง)
  // เดิมรีเซ็ตรหัสแล้วเครื่องเก่ายังเข้าได้อีก 30 วันจนโทเคนหมดอายุ
  passwordChangedAt    DateTime?
  // สอนการใช้งานในแอป — ใครเห็นกล่องต้อนรับ/ข้อความแนะนำแล้ว และดูวิธีใช้หน้าไหนจบแล้ว (เจ้าของงานเลือก ต.ค. 69)
  //
  // NULL = บัญชีที่มีก่อนวันเปิดใช้ (พนักงานเดิม) → ไม่เด้งเอง เห็นข้อความสั้นครั้งเดียว · {"pending":true} = บัญชีใหม่
  // หรือแอดมินกด "ให้ดูวิธีใช้ใหม่" → ขึ้นกล่องต้อนรับครั้งเดียว · welcome / notice / resetAt = เวลา ISO
  // tours = { "<บทบาท>.<หน้า>": เวลาที่กด "เข้าใจแล้ว" } — รายชื่อหน้าอยู่ในแอป (mobile/src/screens/*.howto.ts) เซิร์ฟเวอร์แค่จำ
  // ช่องเดียวแบบ JSON แทนตารางใหม่: ไม่มีใครค้นข้ามคน และหน้าเพิ่มทุกรอบโดยไม่ต้อง migration อีก
  // ไม่มี @default โดยตั้งใจ — ดู migration user_howto_seen (ไฟล์สำรองเก่ากู้กลับต้องได้ "พนักงานเดิม")
  howtoSeen            Json?
  // หัวหน้าภาคที่ดูแลงาน IT ทุกภาค (เจ้าของงานตัดสิน 6 พ.ย. 69) — ได้คนเดียวทั้งบริษัท
  //
  // ใบงาน IT (jobType = "IT") ทุกภาคเป็นของคนนี้ ไม่ตามภาค/ทีมของสาขา · หัวหน้าภาคคนอื่นไม่เห็นใบ IT เลย
  // และคนนี้ทำขั้นของแอดมินในใบ IT ได้ด้วย (ยกเว้นตรวจเคลม) — ขอบเขตอยู่ที่ utils/supervisorScope.ts · utils/itLead.ts
  // ได้คนเดียว: กันด้วยดัชนี unique แบบมีเงื่อนไขใน migration it_lead (Prisma เขียนใน schema ไม่ได้)
  // ล้างเป็น false เมื่อเปลี่ยนเป็นบทบาทอื่น / ถูกลบ — ค้างไว้ = ตั้งกลับเป็นหัวหน้าภาคทีหลังได้ใบ IT ทั้งบริษัทติดมา
  itLead               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  // ถูกลบโดย Super Admin — ตั้งเฉพาะคนที่มีประวัติในระบบแล้ว (คนที่ไม่มีประวัติถูกลบจริง)
  //
  // ลบจริงไม่ได้เพราะใบงาน การใช้รถ บันทึกงาน อ้างถึงคนนี้อยู่ ลบไปประวัติพังหรือหายตาม
  // บัญชีที่ตั้งค่านี้แล้วเข้าระบบไม่ได้ ไม่โผล่ในรายชื่อ แต่ชื่อยังขึ้นในประวัติเดิม
  // employeeCode ถูกเปลี่ยนเป็น "รหัสเดิม~ลบ<id>" เพื่อคืนรหัสให้สร้างบัญชีใหม่ได้
  deletedAt            DateTime?
  // กระดิ่งงานเข้าใหม่นับเฉพาะใบที่เข้ากล่องหลังเวลานี้ (เจ้าของงานเลือก — วันแรกเริ่มจากศูนย์ ไม่ใช่ทุกใบที่ค้างอยู่แล้ว)
  // คนที่มีอยู่ตอนเพิ่มคอลัมน์ได้เวลาที่รัน migration · คนที่เพิ่มทีหลังได้เวลาที่สร้างบัญชี
  bellSince            DateTime              @default(now())
  // แจ้งเตือนเข้ามือถือ: ส่งงานเข้ากล่องถึงเวลานี้แล้ว — รอบถัดไปส่งเฉพาะใบที่เข้าขั้นหลังจากนี้ (null = ยังไม่เคยส่ง เริ่มจากตอนสมัคร)
  pushSince            DateTime?
  vehicleLogs          VehicleLog[]
  branchCheckIns       BranchCheckIn[]
  workLogs             WorkLog[]
  consumableRequests   ConsumableRequest[]   @relation("RequestedBy")
  reviewedRequests     ConsumableRequest[]   @relation("ReviewedBy")
  outageNotes          Outage[]
  outageNoteLogs       OutageNoteLog[]
  createdWorkOrders    WorkOrder[]           @relation("CreatedWorkOrders")
  assignedWorkOrders   WorkOrder[]           @relation("AssignedWorkOrders")
  closedWorkOrders     WorkOrder[]           @relation("ClosedWorkOrders")
  // ใบงานที่คนนี้ย้ายไปถังขยะ — นับเป็นประวัติตอนลบผู้ใช้ ไม่งั้นลบจริงแล้วหน้าถังขยะไม่รู้ว่าใครลบ
  trashedWorkOrders    WorkOrder[]           @relation("TrashedWorkOrders")
  workOrderLogs        WorkOrderLog[]
  workOrderSeens       WorkOrderSeen[]
  pushSubscriptions    PushSubscription[]
  workOrderMessages    WorkOrderMessage[]
  workOrderChatReads   WorkOrderChatRead[]
  adminReviewsSent     AdminReview[]         @relation("AdminReviewsSent")
  adminReviewsAnswered AdminReview[]         @relation("AdminReviewsAnswered")
  checkedParts         WorkOrderPart[]       @relation("CheckedWorkOrderParts")
  partsOutNotes        WorkOrderPart[]       @relation("PartsOutNotes")
  offPartAnswers       WorkOrderPart[]       @relation("OffPartAnswers")
  workOrderAttachments WorkOrderAttachment[]
  workedWorkOrders     WorkOrderWorker[]
  teamDayPlans         TeamDayPlan[]
  teamDayPlanSeats     TeamDayPlanMember[]
  returnedVehicleLogs  VehicleLog[]          @relation("VehicleLogReturnedBy")
  vehicleLogPhotos     VehicleLogPhoto[]
  vehicleDocs          VehicleDoc[]
  vehicleMaintenance   VehicleMaintenance[]
  // แถวตั้งค่าที่คนนี้เปลี่ยน (เวลาปิดรับปล่อยงาน) — นับเป็นประวัติตอนลบผู้ใช้ ไม่งั้นถูกลบจริงแล้ว "ใครเปลี่ยน" หายไปเงียบ ๆ
  appSettingsChanged   AppSetting[]          @relation("AppSettingsChanged")
  // รายการอะไหล่ที่ช่างส่ง/หัวหน้าภาคตัดสิน — นับเป็นประวัติตอนลบผู้ใช้ ไม่งั้นลบจริงแล้ว "ใครส่ง ใครตีกลับ" หายเงียบ ๆ
  partsPicksSent       PartsPick[]           @relation("PartsPicksSent")
  partsPicksReviewed   PartsPick[]           @relation("PartsPicksReviewed")
}

model Vehicle {
  id             Int     @id @default(autoincrement())
  plateNumber    String  @unique
  brand          String?
  model          String?
  type           String?
  // AVAILABLE ว่าง · IN_USE มีคนเบิกอยู่ · MAINTENANCE งดเบิก · INACTIVE เลิกใช้
  // เลิกใช้แทนการลบ — รถที่มีประวัติแล้วลบทิ้งไม่ได้ ไม่งั้นประวัติการใช้รถหายตาม
  status         String  @default("AVAILABLE")
  note           String?
  // เลขไมล์ล่าสุดที่รู้ — ตั้งตอนเบิก/คืน ใช้ตรวจว่าไมล์ที่ช่างกรอกต่อเนื่องไหม
  currentMileage Int     @default(0)

  // ── ทะเบียน & ซ่อมบำรุง ──
  // ผู้รับผิดชอบ เช่น ทีมที่ถือรถคันนี้ — ข้อความอิสระเพราะบางคันเป็นของสำนักงาน
  owner          String?
  // ภาคที่แอดมินกำหนดเอง — ปกติว่าง แล้วหน้าทะเบียนรถหาภาคจากทีมในช่อง owner ผ่านทะเบียนสาขา
  // (ย้ายทีม/นำเข้าไฟล์รถใหม่แล้วภาคตามเอง) ใช้เฉพาะรถที่หาจากทีมไม่ได้ เช่น รถสำนักงาน
  region         String?
  taxExpire      DateTime?
  actExpire      DateTime?
  insExpire      DateTime?
  insCompany     String?
  insPolicy      String?
  // ว่าง = ใช้รอบมาตรฐาน (VEHICLE_RULES) รถบางรุ่นรอบสั้นกว่า
  oilEveryKm     Int?
  oilEveryMonths Int?
  lastOilKm      Int?
  lastOilDate    DateTime?
  // บันทึก/นัดหมาย ที่แสดงในหน้ารวม — ช่างแจ้งซ่อมตอนคืนรถก็มาขึ้นตรงนี้
  maintNote      String?
  updatedAt      DateTime  @default(now()) @updatedAt

  createdAt   DateTime             @default(now())
  logs        VehicleLog[]
  dayPlans    TeamDayPlan[]
  docs        VehicleDoc[]
  maintenance VehicleMaintenance[]
  card        VehicleCard?
}

// บัตรเติมน้ำมัน (Fleet Card) และ Easy Pass ของรถ — เห็นเฉพาะแอดมิน (เจ้าของงานขอ ต.ค. 69)
// แยกตารางจาก Vehicle เพราะรายการรถถูกส่งให้ช่างทุกคน (หน้าเบิกรถ ตัวเลือกรถในแผนงาน) —
// อยู่ในตารางเดียวกันแล้ววันหนึ่งมีคนส่งทั้งแถวออกไป เลขบัตรที่เอาไปใช้จ่ายได้จะหลุดถึงทุกคนเงียบ ๆ
// ตารางนี้ถูกอ่านเฉพาะในเส้นทางของแอดมินที่ตั้งใจดึงมา
model VehicleCard {
  vehicleId      Int      @id
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fleetCardNo    String?
  // วงเงินต่อรอบ (บาท) ตามคอลัมน์ "ยอดบัตรฟีดการ์ด" ในไฟล์รถ
  fleetCardLimit Int?
  easyPassNo     String?
  updatedAt      DateTime @default(now()) @updatedAt
}

model VehicleLog {
  id           Int               @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id])
  userId       Int
  user         User              @relation(fields: [userId], references: [id])
  purpose      String
  destination  String?
  startMileage Int
  endMileage   Int?
  startedAt    DateTime          @default(now())
  endedAt      DateTime?
  status       String            @default("ONGOING")
  // ไมล์ตอนรับ − ไมล์ล่าสุดของรถ ≠ 0 = ไม่ต่อเนื่อง (มีคนใช้รถโดยไม่ลงทะเบียน
  // หรือกรอกผิด) — ยอมให้ผ่านได้ในกรอบ ±MAX_MILEAGE_DIFF แต่แอดมินต้องเห็น
  mileageGap   Int               @default(0)
  note         String?
  returnNote   String?
  // ค่าใช้จ่ายรอบนี้ (บาท) เช่น น้ำมัน ทางด่วน — กรอกตอนคืน
  cost         Int?
  repairNote   String?
  // ใบงานที่ไป (ไม่บังคับ) — รู้ย้อนหลังได้ว่ารถคันไหนไปงานไหน
  workOrderId  Int?
  workOrder    WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  // แอดมินคืนแทน (ช่างลืมกดคืน) — ว่าง = เจ้าของรายการคืนเอง
  returnedById Int?
  returnedBy   User?             @relation("VehicleLogReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  photos       VehicleLogPhoto[]

  @@index([userId, status])
  @@index([vehicleId, startedAt])
}

// รูปรอบคันตอนเบิก/คืน
//
// อัปขึ้นทีละรูประหว่างช่างถ่าย (logId ยังว่าง) แล้วค่อยผูกกับรายการตอนกดยืนยัน —
// ช่างถ่ายต่อได้ไม่ต้องรอ และตอนกดยืนยันไม่ต้องรอส่ง 5 รูปพร้อมกันผ่าน 4G
model VehicleLogPhoto {
  id           Int         @id @default(autoincrement())
  logId        Int?
  log          VehicleLog? @relation(fields: [logId], references: [id], onDelete: Cascade)
  // START ตอนเบิก · END ตอนคืน
  phase        String
  objectKey    String
  // รูปย่อ ~20 KB ไว้แสดงในรายการโดยไม่ต้องขอลิงก์ทีละรูป แบบเดียวกับไฟล์แนบใบงาน
  thumbnail    Bytes?
  uploadedById Int
  uploadedBy   User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([logId])
  @@index([uploadedById, logId])
}

// รูปเอกสารรถ — คันละหนึ่งรูปต่อชนิด (เล่มทะเบียน พ.ร.บ. กรมธรรม์ ป้ายภาษี)
model VehicleDoc {
  id           Int      @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind         String
  objectKey    String
  thumbnail    Bytes?
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([vehicleId, kind])
}

// ประวัติซ่อมบำรุง — เปลี่ยนน้ำมัน ซ่อม ตรวจเช็ค ต่อภาษี และใบแจ้งซ่อมจากช่าง
model VehicleMaintenance {
  id           Int      @id @default(autoincrement())
  vehicleId    Int
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // ดู VEHICLE_MAINT_TYPES ใน src/utils/constants.ts
  type         String
  date         DateTime
  mileage      Int?
  cost         Int      @default(0)
  shop         String?
  detail       String?
  // รูปใบเสร็จ/ใบแจ้งซ่อม (ไม่บังคับ)
  objectKey    String?
  thumbnail    Bytes?
  // ใบแจ้งซ่อมที่มาจากการคืนรถ — ย้อนไปดูรูปตอนคืนได้
  vehicleLogId Int?
  createdById  Int?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([vehicleId, date])
}

model Branch {
  id                Int              @id @default(autoincrement())
  name              String
  code              String           @unique
  address           String?
  // Optional because a branch can be on the machine dashboard long before
  // anyone has stood in it with a phone to record its coordinates. Check-in
  // only offers branches that have them.
  latitude          Float?
  longitude         Float?
  radiusMeters      Int              @default(200)
  // Grouping used by the machine dashboard.
  region            String?
  // COCO (company owned) | DODO (dealer owned)
  ownership         String?
  // ทีมช่างที่ดูแลสาขานี้สำหรับงาน CM — คอลัมน์ "ผู้ดูแล CM" ในไฟล์ทะเบียนสาขา
  //
  // ชื่อช่อง zone เป็นชื่อเดิมตั้งแต่ตอนที่แดชบอร์ดใช้จัดกลุ่ม ไม่ได้เปลี่ยนชื่อ
  // เพราะมีตัวกรองและรายงานหลายที่อ้างถึง zone อยู่ — ความหมายคือทีมช่าง
  //
  // ไฟล์ export รายงานเครื่องไม่มีค่านี้ ตัวนำเข้าจึงไม่แตะค่าเดิม เขียนทับให้ว่างไม่ได้
  zone              String?
  // ทีมช่างที่ดูแลงาน PM — คอลัมน์ "ผู้ดูแล PM" ในไฟล์ทะเบียนสาขา
  //
  // แยกจาก zone เพราะงาน PM กับงาน CM ไม่ได้เป็นของทีมเดียวกันเสมอไป
  // ว่างได้ — ในไฟล์จริงมีสาขาที่ช่องนี้ไม่ได้กรอก ตอนจ่ายงาน PM จะใช้ทีม CM แทน
  pmTeam            String?
  grade             String?
  // วันที่สาขาเปิดทำการ และวันที่ประกันหมด
  //
  // ประกันเป็นเรื่องของสาขาแฟรนไชส์เท่านั้น สาขาบริษัท (รหัสขึ้นต้นด้วย C)
  // ไม่มีประกันเพราะเครื่องเป็นของบริษัทเอง — ดู isCompanyBranch() ใน
  // src/utils/constants.ts
  //
  // ว่างได้ทั้งคู่ เพราะทะเบียนสาขาชุดเดิมไม่มีสองค่านี้ และจะทยอยเติมเข้ามา
  openedAt          DateTime?
  warrantyExpiresAt DateTime?
  // สถานะสาขาจาก CRM — active | inactive
  //
  // ห้ามใช้ช่องนี้เก็บ "สาขายกเลิก" เพราะตัวนำเข้ารายงานเครื่องเขียนทับทุกรอบ
  // จากคอลัมน์ status ในไฟล์ ซึ่งเป็น active เสมอ ใช้ cancelledAt แทน
  status            String?          @default("active")
  // สาขาที่เลิกกิจการแล้ว — ว่าง = ยังเปิดอยู่
  //
  // เครื่องของสาขาที่ปิดไปแล้วยังถูก export ออกมาเป็น state 0 ทุกรอบ
  // ถ้าไม่กันไว้ เคสจะเปิดค้างตลอดกาล สะสม SLA และคะแนนทั้งที่ไม่มีอะไรให้ซ่อม
  cancelledAt       DateTime?
  cancelledNote     String?
  // Supervisor (COCO) ที่ดูแลสาขานี้ — คอลัมน์ ERP → Name-Surname ในไฟล์ Area Team
  //
  // เก็บที่สาขา ไม่ใช่รายการรหัสสาขาที่ผู้ใช้ เพราะสาขาหนึ่งมี Supervisor คนเดียว
  // เก็บที่ผู้ใช้จะมีสองคนถือสาขาเดียวกันได้หลังย้ายคน แล้วต้องคอยลบออกจากคนเก่า
  cocoSupervisorId  Int?
  cocoSupervisor    User?            @relation("CocoSupervisor", fields: [cocoSupervisorId], references: [id], onDelete: SetNull)
  cocoMaids         CocoMaidBranch[]
  // สาขานี้มีคนดูแลแทนอยู่ — เป็นสาขาของ coverFor (เช่นลาออก) ที่ฝากให้ cocoSupervisor ถือไว้ก่อน (เจ้าของงานขอ ต.ค. 69)
  //
  // จำไว้เพื่อส่งต่อให้คนใหม่ได้ทีเดียวเฉพาะสาขาที่ฝากไว้ สาขาเดิมของคนดูแลแทนไม่ติดไปด้วย
  // เก็บชื่อแยกเพราะบัญชีคนที่ลาออกอาจถูกลบจริง (ไม่มีประวัติ) แล้ว coverForId กลายเป็นว่าง
  coverForId        Int?
  coverFor          User?            @relation("CoverFor", fields: [coverForId], references: [id], onDelete: SetNull)
  coverForName      String?
  coverSince        DateTime?
  // ใช้รหัสของสาขาที่ปิดแล้วกับสาขาใหม่ (เจ้าของงานตัดสิน 4 พ.ย. 69: "ไม่รวมสาขา เปลี่ยนใหม่ คือข้อมูลใหม่ทั้งหมด เเต่ยังเก็บประวัติเก่าอยู่")
  //
  // บริษัทเอารหัสของสาขาที่ปิดไปแล้วมาใช้กับร้านอื่น (C0546 นครปฐม → ภูเก็ต) — code เป็น @unique และไฟล์ทุกชนิดจับคู่สาขาด้วยรหัส
  // สาขาเดิมจึงเปลี่ยนรหัสเป็น "C0546 (เดิม)" ("(เดิม 2)" ถ้าซ้ำ) แล้วเก็บใบงาน เครื่อง ประวัติของตัวเองไว้ครบ (ผูกด้วย id)
  // ไฟล์รอบหน้าที่ยังมี C0546 ไปลงสาขาใหม่ ไม่ปนกับของเดิม · ดู utils/branchCodeReuse.ts
  //
  // originalCode = รหัสก่อนยกให้สาขาใหม่ (อยู่ที่สาขาเดิม) — ค้น "C0546" เจอทั้งสองสาขา และรู้ว่า "(เดิม)" มาจากรหัสไหน
  originalCode      String?
  // สาขาใหม่: รับรหัสต่อจากสาขาไหน (ลบสาขาเดิมได้เฉพาะสาขาที่ไม่มีอะไรผูก — ลบแล้วช่องนี้ว่าง)
  reusedFromId      Int?
  reusedFrom        Branch?          @relation("BranchCodeReuse", fields: [reusedFromId], references: [id], onDelete: SetNull)
  reusedBy          Branch[]         @relation("BranchCodeReuse")
  // สาขาใหม่: เวลาที่รับรหัสต่อ — ไฟล์สาขายกเลิกเป็นไฟล์สะสมไม่มีวันที่ แถวรหัสนี้ที่ยังค้างในไฟล์คือการปิดสาขาเดิม
  // ตัวนำเข้าไฟล์นั้นจึงข้ามรหัสของสาขาที่มีค่านี้ (ปิดสาขาใหม่ให้กดในแอป) · แยกจาก reusedFromId เพราะต้องอยู่แม้สาขาเดิมถูกลบ
  reusedAt          DateTime?
  createdAt         DateTime         @default(now())
  checkIns          BranchCheckIn[]
  workLogs          WorkLog[]
  machines          Machine[]
  outages           Outage[]
  scoreSnapshots    ScoreSnapshot[]
  workOrders        WorkOrder[]
  teamMoves         BranchTeamMove[]
  pins              BranchPin[]
  logs              BranchLog[]

  @@index([cocoSupervisorId])
}

// One washer or dryer installed at a branch.
model Machine {
  id          Int         @id @default(autoincrement())
  branchId    Int
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // Label on the machine itself, e.g. W3 (washer) or D12 (dryer).
  code        String
  // WASHER | DRYER
  type        String
  // ON | OFF — สรุปสถานะล่าสุด เก็บไว้เพื่อความสะดวกในการค้น
  // ส่วนเวลาที่ใช้คิด SLA อยู่ที่ Outage ซึ่งเป็นตัวจริง
  status      String      @default("ON")
  brand       String?
  // รุ่นของเครื่อง เช่น HC60 — ไฟล์ export ไม่มีมาให้ คนกรอกตอนเปิดใบงาน
  // เก็บไว้ที่เครื่อง ไม่ใช่ที่ใบงาน เพราะรุ่นเป็นของตัวเครื่อง ไม่ได้เปลี่ยนไปตามงาน
  // กรอกครั้งเดียวแล้วครั้งต่อไปขึ้นให้เอง ไม่ต้องถามซ้ำทุกใบ
  model       String?
  // ขนาดเครื่องเป็นกิโลกรัม เช่น 10 13 18 — ไฟล์ export ไม่มีมาให้เหมือนรุ่น
  //
  // เก็บเป็นตัวเลขไม่ใช่ข้อความอย่าง "10 kg" เพราะต้องเอาไปจัดกลุ่มและเรียงได้
  // ว่าขนาดไหนเสียบ่อย ถ้าเก็บเป็นข้อความจะได้ "10kg" "10 กก." "10" ปนกัน
  // จนรวมยอดไม่ได้ หน่วยเป็น kg ตายตัวทั้งระบบ จึงไม่ต้องเก็บหน่วยไปด้วย
  capacityKg  Int?
  // ค่า state ดิบจากไฟล์ export — 0 คือเครื่องดับ ค่าอื่นข้ามตามที่ตกลงกัน
  stateCode   String?
  // เครื่องที่ถอดออกไปแล้ว — ว่าง = ยังติดตั้งอยู่
  //
  // เหมือน Branch.cancelledAt แต่ระดับเครื่อง สำหรับสาขาที่ยังเปิดอยู่
  // แต่ถอดเครื่องออกบางตัว ซึ่งเจอบ่อยกว่าปิดทั้งสาขา
  removedAt   DateTime?
  removedNote String?
  updatedAt   DateTime    @updatedAt
  outages     Outage[]
  workOrders  WorkOrder[]

  @@unique([branchId, code])
  @@index([status])
}

// หนึ่งเคสของปัญหา ตั้งแต่เห็นครั้งแรกจนหายไปจากไฟล์
//
// ไฟล์ export บอกแค่ว่า "ตอนนี้ใครมีปัญหา" ไม่ได้บอกว่าเริ่มเมื่อไหร่
// ระบบจึงต้องจำเอง: เจอในไฟล์ครั้งแรก = เปิดเคส, หายไปจากไฟล์ = ปิดเคส
// เวลาที่ค้างอยู่ระหว่างนั้นคือ SLA และเคสที่ปิดแล้วกลายเป็นประวัติสำหรับทำรายงาน
model Outage {
  id          Int       @id @default(autoincrement())
  // MACHINE_OFF (เครื่องดับ รายเครื่อง) | SIGNAL_LOST (สัญญาณหาย ทั้งสาขา)
  kind        String
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // ว่างสำหรับ SIGNAL_LOST เพราะเป็นปัญหาระดับสาขา ไม่ใช่ของเครื่องใดเครื่องหนึ่ง
  machineId   Int?
  machine     Machine?  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  // snapshot ล่าสุดที่ยังเห็นปัญหานี้ ใช้บอกว่าของจริงหายไปช่วงไหน
  lastSeenAt  DateTime
  // ว่าง = ยังไม่หาย เคสที่เปิดอยู่คือสิ่งที่แดชบอร์ดแสดง
  endedAt     DateTime?
  // ทำไมถึงปิด — ดูค่าที่ใช้ได้ที่ CLOSE_REASONS ใน src/utils/constants.ts
  //
  // ต้องแยก "ซ่อมเสร็จ" ออกจาก "สาขาปิด/ถอดเครื่อง" ไม่งั้นเครื่องที่ค้างมา 40 วัน
  // แล้วสาขาปิด จะถูกนับเป็นงานซ่อมที่ใช้เวลา 40 วัน แล้วค่าเฉลี่ยในรายงานเพี้ยนถาวร
  // ว่าง = เคสเก่าที่ปิดก่อนมีช่องนี้ ถือว่าซ่อมเสร็จตามเดิม
  closeReason String?

  // สิ่งที่คนกรอกเอง ไฟล์ export ไม่มีให้ — บอกว่าเสียเพราะอะไรและติดอยู่ที่ขั้นไหน
  // ผูกกับเคส ไม่ใช่กับเครื่อง เคสใหม่จึงเริ่มจากว่างเสมอ ไม่เอาอาการเก่ามาปน
  symptom          String?
  // ดูค่าที่ใช้ได้ที่ WORK_STATUSES ใน src/utils/constants.ts
  workStatus       String?
  // วันที่ช่างนัดเข้าไปแก้ ใช้ตอน workStatus = WAITING_TECH
  // เก็บเป็นวันที่อย่างเดียว ไม่มีเวลา เพราะนัดกันเป็นวัน
  scheduledVisitAt DateTime?
  noteUpdatedAt    DateTime?
  noteUpdatedById  Int?
  noteUpdatedBy    User?           @relation(fields: [noteUpdatedById], references: [id])
  // อะไหล่ที่เคสนี้รออยู่ ใช้ตอน workStatus = WAITING_PARTS
  parts            OutagePart[]
  noteLogs         OutageNoteLog[]
  workOrders       WorkOrder[]

  @@index([kind, endedAt])
  @@index([branchId, endedAt])
}

// ประวัติว่าใครมากรอกอาการ/สถานะของเคสไหน เมื่อไหร่
//
// ฟิลด์ noteUpdatedBy บน Outage บอกได้แค่คนล่าสุด พอมีคนแก้ทับก็ไม่เหลือร่องรอย
// ว่าก่อนหน้าใครเคยกรอกอะไรไว้ ตารางนี้เก็บทุกครั้งที่กดบันทึกแยกไว้ต่างหาก
//
// เก็บเป็น snapshot ของค่าหลังบันทึก ไม่ใช่ส่วนต่าง เพราะอ่านย้อนหลังแล้วเข้าใจ
// ได้ทันทีว่าตอนนั้นเคสอยู่ในสภาพไหน โดยไม่ต้องไล่ประกอบจากรายการก่อนหน้า
model OutageNoteLog {
  id       Int    @id @default(autoincrement())
  outageId Int
  outage   Outage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  // ว่างได้เผื่อผู้ใช้ถูกลบทีหลัง ประวัติยังต้องอยู่
  userId   Int?
  user     User?  @relation(fields: [userId], references: [id])

  symptom          String?
  workStatus       String?
  scheduledVisitAt DateTime?
  // สรุปอะไหล่เป็นข้อความ เช่น "SPOS0002 x8, CB-0305" เก็บ ณ ตอนนั้นเลย
  // ไม่ผูก relation เพราะถ้าอะไหล่ถูกลบทีหลัง ประวัติต้องยังอ่านออก
  partsSummary     String?

  createdAt DateTime @default(now())

  @@index([outageId, createdAt])
  @@index([createdAt])
}

// อะไหล่ที่เคสหนึ่งรออยู่
//
// ชี้ไปที่ SparePart แทนที่จะให้พิมพ์รหัสเอง เพราะรหัสที่พิมพ์มือจะสะกดไม่ตรงกัน
// แล้วรวมยอดว่าทั้งประเทศค้างอะไหล่ตัวไหนอยู่กี่ตัวไม่ได้
model OutagePart {
  id          Int       @id @default(autoincrement())
  outageId    Int
  outage      Outage    @relation(fields: [outageId], references: [id], onDelete: Cascade)
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  quantity    Int       @default(1)

  // อะไหล่ตัวเดิมในเคสเดียวกันมีได้แถวเดียว เพิ่มซ้ำให้ไปบวกจำนวนแทน
  @@unique([outageId, sparePartId])
  @@index([sparePartId])
}

// บันทึกการอัปโหลดแต่ละครั้ง ไว้ดูย้อนหลังว่าตัวเลขที่เปลี่ยนมาจากไฟล์ไหน
model MachineImport {
  id                 Int             @id @default(autoincrement())
  uploadedById       Int?
  fileName           String?
  // เวลาของ snapshot ที่ใช้เป็นจุดอ้างอิงในการเปิด/ปิดเคส
  snapshotAt         DateTime
  rowsInFile         Int
  duplicateRows      Int
  branchesTouched    Int
  machinesOff        Int
  branchesSignalLost Int
  opened             Int
  closed             Int
  // คะแนนรวม ณ ตอนนั้น เก็บซ้ำไว้ตรงนี้ด้วยเพื่อดึงกราฟแนวโน้มได้ด้วยคิวรีเดียว
  // โดยไม่ต้องรวมยอดจาก ScoreSnapshot ทีละรอบ
  machineOffScore    Int             @default(0)
  signalLostScore    Int             @default(0)
  totalScore         Int             @default(0)
  createdAt          DateTime        @default(now())
  scoreSnapshots     ScoreSnapshot[]
}

// คะแนนของแต่ละสาขา ณ ตอนที่อัปโหลดไฟล์แต่ละรอบ
//
// คะแนนบนแดชบอร์ดคิดสดจากเวลาปัจจุบัน พอเคสปิดไปคะแนนก็หายไปด้วย
// ตารางนี้ตรึงค่าไว้ทุกรอบอัปโหลด จึงย้อนดูได้ว่าสัปดาห์ที่แล้วภาคไหนหนักกว่ากัน
//
// เก็บภาค/ทีมช่าง/เจ้าของ ณ ตอนนั้นติดไปด้วย ไม่ได้อ้างอิงค่าปัจจุบันของสาขา
// เพราะถ้าอัปโหลดทะเบียนสาขาใหม่แล้วสาขาย้ายภาค รายงานย้อนหลังต้องไม่เปลี่ยนตาม
model ScoreSnapshot {
  id         Int            @id @default(autoincrement())
  importId   Int?
  import     MachineImport? @relation(fields: [importId], references: [id], onDelete: Cascade)
  snapshotAt DateTime

  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  region    String?
  zone      String?
  ownership String?
  grade     String?

  // MACHINE_OFF | SIGNAL_LOST — แยกกันเพราะคนละทีมรับผิดชอบและคะแนนต่อวันไม่เท่ากัน
  kind     String
  cases    Int
  score    Int
  breached Int

  @@unique([importId, branchId, kind])
  @@index([snapshotAt])
  @@index([branchId, snapshotAt])
}

model BranchCheckIn {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  branchId       Int
  branch         Branch   @relation(fields: [branchId], references: [id])
  latitude       Float
  longitude      Float
  distanceMeters Float
  withinRadius   Boolean
  note           String?
  checkedInAt    DateTime @default(now())
}

model WorkLog {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  workDate        DateTime
  taskDescription String
  hoursSpent      Float?
  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  createdAt       DateTime @default(now())
}

model TroubleshootingGuide {
  id        Int      @id @default(autoincrement())
  category  String
  title     String
  symptom   String
  solution  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An interactive diagnostic tree imported from a manufacturer flowchart.
// Technicians answer ใช่/ไม่ at each node until they reach a fix.
model TroubleshootFlow {
  id          Int                 @id @default(autoincrement())
  title       String
  machineType String?
  notes       String?
  // Key of the node the technician starts at.
  rootKey     String?
  sourceFile  String?
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  nodes       TroubleshootNode[]
  images      TroubleshootImage[]
}

model TroubleshootNode {
  id         Int              @id @default(autoincrement())
  flowId     Int
  flow       TroubleshootFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  // Stable identifier used by yesKey/noKey; unique within a flow.
  key        String
  // QUESTION | ACTION
  kind       String
  text       String
  // Marker such as "(1)" cross-referencing the wiring diagrams.
  stepNumber String?
  yesKey     String?
  noKey      String?
  order      Int              @default(0)

  @@unique([flowId, key])
}

model TroubleshootImage {
  id       Int              @id @default(autoincrement())
  flowId   Int
  flow     TroubleshootFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  mimeType String
  data     Bytes
  order    Int              @default(0)
}

model SparePart {
  id             Int                  @id @default(autoincrement())
  partCode       String               @unique
  name           String
  brand          String?
  category       String?
  description    String?
  // Either a full external URL, or a path served by this API
  // ("/api/spare-parts/:id/image") when a photo was uploaded.
  imageUrl       String?
  // Part No. ของผู้ผลิต (คอลัมน์ "Part No." ในไฟล์อะไหล่ Huebsch/Maytag — เจ้าของงานขอ ต.ค. 69)
  // ช่างค้นด้วยเลขที่พิมพ์บนตัวอะไหล่ (W11327190) ได้ · หลายเลขคั่นด้วย ", "
  partNo         String?
  // อะไหล่นอกสโตร์ (ไม่มี SKU) — หัวหน้าภาค/ช่างพิมพ์ชื่อเอง (เจ้าของงานขอ ต.ค. 69)
  // เก็บเป็นแถวในตารางนี้ให้ทุกขั้นของใบงาน (เช็ค แยกใบรออะไหล่ ปิดงาน) ใช้ทางเดียวกับของในสโตร์
  // partCode = "[นอกสโตร์] ชื่อ" ชื่อเดียวกันคือแถวเดียวกัน · ไม่ขึ้นในหน้ารายการอะไหล่/ค้นหา
  offCatalog     Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  image          SparePartImage?
  outageParts    OutagePart[]
  workOrderParts WorkOrderPart[]
  partsPickItems PartsPickItem[]
  // ไฟล์ยี่ห้อที่อะไหล่นี้อยู่ (ล็อกยี่ห้อดูที่นี่ ไม่ใช่ช่อง brand ด้านบน) — ไม่มีแถวเลย = ไม่อยู่ในไฟล์ไหน ช่างเลือกไม่ได้
  brandFiles     SparePartBrandFile[]
}

// Uploaded photos live in their own table so listing parts never has to
// pull image bytes along with the row.
model SparePartImage {
  sparePartId Int       @id
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  mimeType    String
  data        Bytes
  // sha256 ของรูปต้นฉบับในไฟล์ Excel ก่อนเบราว์เซอร์ย่อรูป (ไฟล์อะไหล่ที่รูปเต็มขนาดเกิน 50 MB)
  // อัปเดตรอบหน้าเทียบกับค่านี้ — ย่อซ้ำแต่ละครั้งได้ไบต์ไม่เหมือนเดิม ถ้าเทียบ data รูปจะ "เปลี่ยน" ทุกรอบ
  // null = data คือรูปต้นฉบับเอง (อัปโหลดในแอป / ไม่ได้ย่อ)
  sourceHash  String?
  updatedAt   DateTime  @updatedAt
}

model ConsumableItem {
  id           Int                     @id @default(autoincrement())
  name         String
  unit         String                  @default("ชิ้น")
  stockQty     Int                     @default(0)
  createdAt    DateTime                @default(now())
  requestItems ConsumableRequestItem[]
}

model ConsumableRequest {
  id           Int                     @id @default(autoincrement())
  userId       Int
  user         User                    @relation("RequestedBy", fields: [userId], references: [id])
  // PENDING | APPROVED | REJECTED — stock is deducted when a request is approved.
  status       String                  @default("PENDING")
  note         String?
  createdAt    DateTime                @default(now())
  reviewedById Int?
  reviewedBy   User?                   @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  items        ConsumableRequestItem[]
}

model ConsumableRequestItem {
  id        Int               @id @default(autoincrement())
  requestId Int
  request   ConsumableRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId    Int
  item      ConsumableItem    @relation(fields: [itemId], references: [id])
  quantity  Int
}

// ใบงานซ่อม — สิ่งที่ช่างถือไปทำ ต่างจาก Outage ที่เป็นสภาพของเครื่อง
//
// Outage เปิดและปิดตามไฟล์ export เท่านั้น คนสั่งปิดเองไม่ได้ เพราะไฟล์คือความจริง
// ว่าเครื่องกลับมาหรือยัง ส่วนใบงานเป็นเรื่องของคน — ใครรับ ไปเมื่อไหร่ ทำอะไรไป
// สองอย่างนี้จึงปิดคนละเวลาได้ ปิดใบงานแล้วเครื่องยังไม่กลับมาก็เป็นไปได้
// และต้องเห็นด้วยว่าเป็นแบบนั้น
model WorkOrder {
  id        Int     @id @default(autoincrement())
  // รหัสที่คนอ่าน เช่น WO-00042 — ตั้งจาก id หลังสร้าง จึงไม่มีทางชนกัน
  code      String  @unique
  // OUTAGE (เปิดจากกระดานติดตาม) | MANUAL (เปิดเอง) | FORM (นำเข้าจากไฟล์ฟอร์มแจ้งซ่อม COCO)
  source    String  @default("MANUAL")
  // แถวในไฟล์ฟอร์มแจ้งซ่อมที่เป็นต้นเรื่อง (ลายนิ้วมือของแถว) — นำเข้าไฟล์เดิมซ้ำแล้วไม่เกิดใบซ้ำ · เปิดเอง = ว่าง
  importKey String? @unique

  // ระงับชั่วคราว (เจ้าของงานเลือก พ.ย. 69) — ใบออกจากกล่องงานและหยุดนับวันค้างจนถึง holdUntil (เที่ยงคืนเวลาไทยของวันที่กลับมาทำ)
  // ไม่มีงานประจำมาปลด: ระงับอยู่ = holdUntil > ตอนนี้ · กดกลับมาทำต่อก่อนกำหนด = holdUntil ย้ายมาเป็นตอนที่กด
  // เก็บเฉพาะรอบล่าสุด — ประวัติทุกรอบอยู่ใน WorkOrderLog (HOLD / RESUMED)
  holdUntil  DateTime?
  holdReason String?
  heldAt     DateTime?

  // เคสที่เป็นต้นเรื่อง ว่างได้เพราะใบงานที่เปิดเองไม่ได้มาจากเคสไหน
  outageId  Int?
  outage    Outage?  @relation(fields: [outageId], references: [id], onDelete: SetNull)
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // ว่างเมื่อเป็นงานระดับสาขา เช่น สัญญาณหาย ซึ่งไม่ได้เจาะจงเครื่องไหน
  machineId Int?
  machine   Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  // ประเภทงาน — ดูค่าที่ใช้ได้ที่ JOB_TYPES ใน src/utils/constants.ts
  jobType String  @default("CM")
  title   String
  detail  String?

  // ── อาการและสถานะ — ที่เดียวกับที่เคยกรอกบนกระดาน ──
  //
  // อยู่ที่ใบงานเพราะคนที่รู้คือช่างที่ถือใบงานไป ไม่ใช่คนที่นั่งดูกระดาน
  // กระดานยังแสดงค่าเหล่านี้อยู่ แต่ดึงจากใบงานแทนที่จะให้กรอกซ้ำอีกที่
  //
  // ค่าที่กรอกที่นี่ถูกคัดลอกไปไว้ที่ Outage ด้วย เพื่อให้ตัวกรอง รายงาน
  // และประวัติที่อ่านจากเคสอยู่แล้วทำงานต่อได้โดยไม่ต้องรื้อ
  // คนที่สาขาให้ติดต่อเรื่องใบงานนี้ กรอกตอนเปิดใบงาน
  //
  // เก็บที่ใบงานไม่ใช่ที่สาขา เพราะคนเฝ้าร้านเปลี่ยนตามกะและตามช่วง
  // เบอร์ที่ใช้ได้เมื่อสามเดือนก่อนไม่ได้แปลว่าวันนี้โทรไปแล้วเจอคนเดิม
  contactName  String?
  contactPhone String?

  symptom    String?
  // ดูค่าที่ใช้ได้ที่ WORK_STATUSES ใน src/utils/constants.ts — ชุดเดียวกับของเคส
  workStatus String?
  // ดูค่าที่ใช้ได้ที่ WORK_ORDER_PRIORITIES ใน src/utils/constants.ts
  priority   String  @default("NORMAL")
  // ขั้นที่ใบงานเดินไปถึง — ดูค่าที่ใช้ได้ที่ WORK_ORDER_STATUSES
  //
  // เดินทีละขั้นตามสายงานจริง: แอดมินเปิดเรื่อง → หัวหน้าภาคระบุอะไหล่ →
  // แอดมินเช็คคลัง → หัวหน้าภาคจ่ายงาน → ช่างนัดวัน → ช่างปิดงาน
  // ข้ามขั้นไม่ได้ ไม่งั้นจะมีใบที่จ่ายให้ช่างทั้งที่ยังไม่รู้ว่ามีอะไหล่หรือเปล่า
  status     String  @default("NEW")

  // งานนี้ต้องใช้อะไหล่ไหม — หัวหน้าภาคเป็นคนตัดสินในขั้นที่ 2
  //
  // ว่าง = ยังไม่ได้ตัดสิน · true = ต้องใช้ ไปให้แอดมินเช็คคลังต่อ
  // false = ไม่ใช้ ข้ามขั้นเช็คคลังไปจัดคิวช่างเลย เช่น เข้าไปประเมินอาการก่อน
  needsParts Boolean?

  // ทีมช่างที่รับงานนี้ — ตรงกับ Branch.zone ซึ่งมาจากคอลัมน์ "ทีมช่าง" ในไฟล์ทะเบียนสาขา
  //
  // งานถูกจ่ายให้ "ทีม" ไม่ใช่ "คน" เพราะทีมเป็นหน่วยที่รับผิดชอบสาขาจริง
  // ส่วนใครไปจริงในวันนั้นเป็นเรื่องที่รู้ตอนปิดงาน ไม่ใช่ตอนจ่ายงาน
  assignedTeam      String?
  // ช่างที่ถูกจ่ายงานให้แบบรายคน — ของใบงานเก่าก่อนเปลี่ยนมาจ่ายเป็นทีม
  //
  // ไม่ได้เขียนค่าใหม่แล้ว แต่ยังอ่านอยู่ เพื่อให้ใบที่ค้างอยู่ตอนเปลี่ยนระบบ
  // ยังอยู่ในมือคนเดิม ไม่ใช่หายไปจากรายการของเขาทั้งที่ยังทำไม่เสร็จ
  assignedToId      Int?
  assignedTo        User?     @relation("AssignedWorkOrders", fields: [assignedToId], references: [id])
  // วันที่นัดเข้าไปทำ เก็บเป็นวันอย่างเดียว เพราะนัดกันเป็นวัน
  scheduledAt       DateTime?
  // ขั้นรอเบิกอะไหล่ (ก่อนเสนอราคา) — วันที่แอดมินคาดว่าอะไหล่ที่หมดจะเข้า ไม่บังคับ
  // เลยวันนี้แล้วรายการขึ้นเตือนให้ตามผู้ขาย · ล้างเมื่ออะไหล่ครบ
  partsExpectedAt   DateTime?
  // เวลานัด "HH:MM" แยกจากวัน — ใบเก่านัดกันเป็นวันอย่างเดียว ว่างจึงแปลว่า
  // "ทั้งวัน" ไม่ใช่เที่ยงคืน ถ้ารวมไว้ในช่องเดียวกันจะแยกสองอย่างนี้ไม่ออก
  scheduledTime     String?
  // ลูกค้ารับนัดหรือยัง — PENDING รอคอนเฟิร์ม · CONFIRMED ลูกค้าคอนเฟิร์ม
  // ADMIN_PICKED ลูกค้าสะดวกทุกวัน แอดมินเลือกวันให้ (ดู APPOINTMENT_STATUSES)
  appointmentStatus String?
  // วันที่แอดมินให้นัดได้แม้ปิดนัดแล้ว (แก้เป็นงานด่วน · เวลาปิดนัดงานพรุ่งนี้ 2 พ.ย. 69) เก็บเป็นวันแบบเดียวกับ scheduledAt
  // ใช้ได้เฉพาะใบนี้ วันนั้น · หัวหน้าภาคนัดวันนั้นแล้วยังเก็บไว้ (ป้าย "แอดมินแก้เป็นงานด่วน") · แยกจาก priority
  // เก็บเป็นวัน ไม่ใช่ true/false — นัดวันอื่นแล้วหมดผลเอง แม้ทางที่เปลี่ยนวันนัดทางไหนลืมล้าง
  urgentReleaseFor  DateTime?

  // ── ตรวจหน้างาน ──
  // หัวหน้าภาคระบุอะไหล่ไม่ได้จนกว่าจะมีคนไปดู — ผลตรวจเก็บไว้ที่ใบงาน
  // เพราะคนที่ระบุอะไหล่รอบถัดไปต้องอ่านมันตอนตัดสินใจ ไม่ใช่ไปค้นในประวัติ
  inspectedAt    DateTime?
  inspectionNote String?

  // ใบงานรออะไหล่ที่แยกออกมาจากใบนี้ — อะไหล่บางตัวหมด หรือไปแล้วเปลี่ยนไม่ครบ
  //
  // เป็นใบใหม่ไม่ใช่สถานะของใบเดิม เพราะของที่มีอยู่ซ่อมได้เลย ไม่ควรถูกกั้น
  // ด้วยของที่ยังไม่มา แต่ต้องลิงก์กันไว้ ไม่งั้นดูไม่ออกว่าเป็นงานเดียวกัน
  parentId Int?
  parent   WorkOrder? @relation("WorkOrderSplit", fields: [parentId], references: [id], onDelete: SetNull)

  // ใบทดสอบ — คัดลอกจากใบจริงเพื่อลองขั้นตอน (เช่นเคลมอะไหล่) โดยไม่แตะใบจริง
  // ใบจริงที่เอามาเดินทดสอบตรง ๆ จะถูกปิดงานจริง · ทดสอบเสร็จให้ลบทิ้ง
  isTest   Boolean     @default(false)
  // คัดลอกมาจากใบไหน — แค่อ้างอิง ใบต้นทางถูกลบไปก็ไม่กระทบ
  testOfId Int?
  children WorkOrder[] @relation("WorkOrderSplit")

  createdById Int?
  createdBy   User?    @relation("CreatedWorkOrders", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── ปิดงาน ──
  closedAt          DateTime?
  closedById        Int?
  closedBy          User?     @relation("ClosedWorkOrders", fields: [closedById], references: [id])
  // ผลของงาน ไม่ใช่แค่ "ปิดแล้ว" — ดู WORK_ORDER_RESULTS ใน src/utils/constants.ts
  closeResult       String?
  closeNote         String?
  // คนนอกระบบที่ไปด้วย เช่น ช่างผู้รับเหมาหรือคนของสาขา
  //
  // มีไว้เพราะคนที่ไปหน้างานจริงไม่ได้มีบัญชีในระบบทุกคน และถ้าไม่มีช่องให้กรอก
  // ชื่อเหล่านั้นจะไปโผล่ในช่องสรุปงานแทน ซึ่งค้นหาไม่ได้
  closeOtherWorkers String?
  // ใบงาน SUB: ทีม outsource ที่เข้าทำจริง (เจ้าของงานขอ ต.ค. 69) — แยกจากชื่อคนนอกระบบ
  // รายงานจะนับได้ว่าแต่ละทีม SUB ทำไปกี่งาน ถ้าเก็บเป็นข้อความรวมกับชื่อคนจะนับไม่ได้
  closeSubTeam      String?

  // ── ถังขยะ (เจ้าของงานตัดสิน 4 พ.ย. 69) ──
  //
  // ลบใบงาน = ย้ายมาถังขยะ ไม่ใช่ลบแถว — แอดมินกู้คืนได้ 30 วันพร้อมอะไหล่ รูป ประวัติ แล้วระบบลบจริง (utils/trash.ts)
  // เก็บเป็นช่องในตารางเดิม ไม่ย้ายไปตารางอื่น: ลูกทั้งหมด (อะไหล่ ประวัติ ไฟล์ เคลม) ชี้มาที่ id นี้อยู่แล้ว
  // ย้ายตารางคือต้องย้ายลูกตามทุกตาราง และกู้คืนต้องย้ายกลับให้ครบ — ช่องเดียวกู้คืนคือล้างช่องนี้
  // ราคาที่จ่าย: ทุกที่ที่อ่านใบงานต้องกรอง deletedAt = null (ALIVE ใน utils/trash.ts) — รายการที่กรองอยู่ใน README
  // ขั้น (status) ไม่ถูกแตะตอนย้ายไปถังขยะ — กู้คืนแล้วใบอยู่ขั้นเดิมเป๊ะ ไม่ต้องจำแยก
  deletedAt    DateTime?
  deletedById  Int?
  deletedBy    User?     @relation("TrashedWorkOrders", fields: [deletedById], references: [id], onDelete: SetNull)
  // TRASH_REASONS ใน utils/trash.ts · deleteNote = ข้อความเพิ่ม (บังคับเมื่อเลือก "อื่น ๆ")
  deleteReason String?
  deleteNote   String?

  parts        WorkOrderPart[]
  services     WorkOrderService[]
  logs         WorkOrderLog[]
  seens        WorkOrderSeen[]
  messages     WorkOrderMessage[]
  chatReads    WorkOrderChatRead[]
  attachments  WorkOrderAttachment[]
  claims       PartClaim[]
  workers      WorkOrderWorker[]
  vehicleLogs  VehicleLog[]
  adminReviews AdminReview[]
  partsPicks   PartsPick[]

  @@index([status, createdAt])
  // รายงานอะไหล่ที่ไปแต่ละสาขา: ตัวเลขบนลิงก์ในใบงาน (ถามทุกครั้งที่แอดมินเปิดใบงาน) และ Excel อ่านใบงานทีละสาขา — ไม่มี index
  // ฐานข้อมูลต้องไล่ใบงานทั้งระบบทุกครั้ง
  @@index([branchId])
  @@index([assignedToId, status])
  @@index([assignedTeam, status])
  @@index([outageId])
  @@index([scheduledAt])
  @@index([parentId])
  // หน้าถังขยะ/ลบครบ 30 วัน/รายชื่อใบในถังที่เซิร์ฟเวอร์จำไว้ อ่าน deletedAt IS NOT NULL ผ่านคอลัมน์แรก
  // ส่วนรายการใบงาน (deletedAt IS NULL + ขั้น) ใช้ทั้งสองคอลัมน์ — แทบทุกแถวเป็น NULL ดัชนีคอลัมน์เดียวช่วยฝั่งนั้นไม่ได้
  // ดัชนีบางส่วน (WHERE deletedAt IS NOT NULL) เล็กกว่า แต่ schema.prisma รุ่นนี้เขียนไม่ได้ — ใส่ใน SQL เองแล้ว
  // migrate diff ที่ README ใช้เช็คจะเห็นเป็นของเกินทุกครั้ง
  @@index([deletedAt, status])
}

// คนที่เข้าไปทำงานจริง บันทึกตอนปิดงาน
//
// แยกเป็นตารางไม่ใช่ข้อความ เพราะต้องนับย้อนได้ว่าใครไปกี่งาน ซึ่งเป็นคำถาม
// ที่จะถูกถามแน่ ๆ เมื่อจ่ายงานเป็นทีม — ชื่อที่เก็บเป็นข้อความรวมกันนับไม่ได้
model WorkOrderWorker {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workOrderId, userId])
  @@index([userId])
}

// อะไหล่ที่ใช้จริงตอนปิดงาน ต่างจาก OutagePart ที่เป็นของที่ "รออยู่"
model WorkOrderPart {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  // WAITING (รออะไหล่ตัวนี้อยู่) | USED (ใช้ไปจริงตอนปิดงาน)
  //
  // สองอย่างนี้ต่างกันจริง ของที่รอกับของที่ใช้ไม่จำเป็นต้องตรงกัน ช่างอาจไปถึง
  // แล้วพบว่าเสียคนละจุด ถ้าเก็บรวมกันจะแยกไม่ออกว่ายอดที่ต้องสั่งซื้อคือเท่าไหร่
  kind        String    @default("USED")

  // ── ผลการเช็คคลัง เฉพาะของที่ kind = WAITING ──
  //
  // ว่าง = ยังไม่มีใครเช็ค · true = มีของ พร้อมบอกว่าอยู่คลังไหน · false = หมด
  // ถ้ามีตัวไหน false ใบงานจะขึ้นสถานะ "รออะไหล่" ให้เอง
  inStock       Boolean?
  // ชื่อคลังที่มีของ ตามรายชื่อใน src/documents/warehouses.ts
  warehouse     String?
  // เลขใบเบิกอะไหล่จากระบบคลัง — พิมพ์เอง ไม่ได้ออกเลขให้เอง
  //
  // เก็บรายตัวไม่ใช่รายใบงาน เพราะใบงานที่ช่างส่งกลับมาขอเบิกเพิ่มจะมีใบเบิก
  // ใบที่สอง ถ้าเก็บไว้ที่ใบงานใบเดียว เลขใบแรกจะถูกทับหายไป
  requisitionNo String?
  // ── โอนข้ามคลัง (เจ้าของงานกำหนด ต.ค. 69) — ของอยู่คลังอื่น หัวหน้าภาคเบิกแล้วโอนมาคลังที่จะส่งมอบ ──
  // ระหว่างโอน/หลังโอน warehouse = คลังปลายทาง (ที่ส่งมอบให้ช่าง) · ช่องพวกนี้เก็บต้นทางกับเอกสารของการโอน
  // requisitionNo ยังเป็นใบเบิกส่งมอบ (ออกจากคลังปลายทางไปหน้างาน) — คนละใบกับใบเบิกเพื่อโอน
  transferFrom  String?
  transferReqNo String?
  transferNo    String?
  // ของถึงคลังปลายทางแล้ว — ว่าง = ยังไม่ได้สั่งโอน หรือกำลังโอน (ดู transferNo)
  transferredAt DateTime?
  // ── อะไหล่ส่งให้ลูกค้าแล้ว (เจ้าของงานขอ พ.ย. 69) — แอดมินเบิกจากคลังลาดพร้าว 94 แล้วส่งของไปที่ร้านเอง ช่างไม่ต้องไปรับที่คลัง ──
  // ว่าง = รับที่คลัง (แบบเดิม) · มีค่า = เวลาที่แอดมินบันทึกว่าส่งแล้ว (คนบันทึก = checkedBy ในการบันทึกเดียวกัน)
  // ช่องเวลาช่องเดียวแทน boolean + คน + เวลา: คนกับเวลาอยู่ใน checkedById/checkedAt ของการเบิกครั้งนั้นอยู่แล้ว
  // และอ่านแบบเดียวกับ transferredAt ในตารางนี้ · ผูกกับเลขใบเบิก — ทุกทางที่ล้าง requisitionNo ต้องล้างช่องนี้ด้วย
  // ไม่งั้นเบิกรอบใหม่จะได้ป้าย "ส่งให้ลูกค้าแล้ว" ของรอบก่อนติดมา
  sentToCustomerAt DateTime?
  // หน่วยกับหมายเหตุของอะไหล่นอกสโตร์ (เส้น/ชุด · สเปค แหล่งซื้อ) — ของในสโตร์ไม่ใช้
  unit          String?
  note          String?
  checkedAt     DateTime?
  checkedById   Int?
  checkedBy     User?     @relation("CheckedWorkOrderParts", fields: [checkedById], references: [id])
  // หมายเหตุในรายงานอะไหล่หมด (เจ้าของงานขอ ต.ค. 69) — ขึ้นเฉพาะหน้ารายงานนั้น ไม่ขึ้นในใบงาน
  // ผูกกับแถวสาขา+อะไหล่ (เจ้าของงานเลือก) · มีผลเฉพาะเมื่อเขียนหลังเช็คว่าหมดรอบล่าสุด (outNoteAt >= checkedAt)
  // ของเข้าแล้วหมดซ้ำรอบใหม่ จะได้ไม่เห็นหมายเหตุของรอบก่อนค้างอยู่
  outNote       String?
  outNoteAt     DateTime?
  outNoteById   Int?
  outNoteBy     User?     @relation("PartsOutNotes", fields: [outNoteById], references: [id], onDelete: SetNull)
  // ── อะไหล่นอกสโตร์: จัดหาได้ไหม · จากที่ไหน (เจ้าของงานขอ 4 พ.ย. 69 ตามตัวอย่างที่อนุมัติ) — ของในสโตร์ไม่ใช้ ──
  //
  // WAITING = หัวหน้าภาคตอบตอนระบุอะไหล่: true หาได้ (offKind = แหล่ง) · false หาไม่ได้ (offKind = เหตุผล)
  // USED = ช่างซื้อเองหน้างานตอนปิดงาน: true เสมอ (offKind = ซื้อจากที่ไหน) · ว่าง = ของจากรายการที่หัวหน้าภาคระบุไว้
  // ว่างทั้งแถว = ใบก่อนมีคำถามนี้ หน้าจอขึ้น "ยังไม่ระบุ" ไม่บังคับย้อนหลัง (เจ้าของงานเลือก) ใส่ตอนแก้รายการครั้งหน้า
  //
  // แยกจาก inStock โดยตั้งใจ: inStock คือผลเช็คของแอดมิน หัวหน้าภาคบอก "หาได้" แล้วแอดมินเช็คได้ "ยังหาไม่ได้" ก็มี
  // ถ้าใช้ช่องเดียวกัน คำตอบของคนหนึ่งจะทับของอีกคน แล้วไม่มีใครรู้ว่าหัวหน้าภาคเคยบอกว่าหาได้จากที่ไหน
  // offKind เป็นข้อความ ไม่ใช่ enum — ชุดคำอยู่ที่ OFF_SOURCE_KINDS / OFF_MISSING_REASONS (src/utils/constants.ts)
  // เจ้าของงานเปลี่ยนชื่อชิปได้ (เปลี่ยนชิปแรกตอนอนุมัติ) โดยแถวเก่ายังอ่านออกและไม่ต้อง migrate
  offFound      Boolean?
  offKind       String?
  offDetail     String?
  // ใคร/เมื่อไรที่ตอบคำตอบนี้ — ส่งรายการเดิมซ้ำด้วยคำตอบเดิมไม่เปลี่ยนเวลา (หน้าใบงาน "หัวหน้าภาคแจ้ง · เวลา")
  offAnswerAt   DateTime?
  offAnswerById Int?
  offAnswerBy   User?     @relation("OffPartAnswers", fields: [offAnswerById], references: [id], onDelete: SetNull)

  @@unique([workOrderId, sparePartId, kind])
}

// ค่าบริการที่หัวหน้าช่างระบุให้เสนอราคาลูกค้า (ค่าแรง ค่าเดินทาง ฯลฯ — เจ้าของงานขอ ต.ค. 69)
//
// แยกจาก WorkOrderPart เพราะไม่ใช่ของ — ไม่ต้องเช็คมี/หมด ไม่มีคลังหรือใบเบิก ไม่นับในรายงานอะไหล่
// ไม่มีราคา: ใบเสนอราคาออกจากระบบบัญชี แอดมินใส่ราคาที่นั่น ที่นี่เป็นแค่รายการที่ต้องใส่
model WorkOrderService {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int       @default(1)
  unit        String?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

// เปิดดูใบงานล่าสุดเมื่อไร (ต่อคน ต่อใบ) — กระดิ่ง "งานเข้าใหม่" นับใบในกล่องงานที่เข้าขั้นหลังจากเปิดดูครั้งล่าสุด (พ.ย. 69)
model WorkOrderSeen {
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt      DateTime  @default(now())

  @@id([workOrderId, userId])
}

// แชทในใบงาน (พ.ย. 69) — ช่าง/หัวหน้าภาคถามเรื่องใบนั้น แอดมินตอบในที่เดียวกัน
// แยกจากประวัติ (WorkOrderLog): ข้อความคุยไม่ใช่การเดินขั้น และมีจำนวนมากกว่าประวัติหลายเท่า
model WorkOrderMessage {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  body        String    @default("")
  // รูปในแชท — ถังเดียวกับรูปหน้างาน (ไม่เปิดสาธารณะ) · รูปย่อเก็บในฐานข้อมูลไว้โชว์ในฟองแชท
  imageKey    String?
  imageThumb  Bytes?
  // ลบได้ภายใน 5 นาทีหลังส่ง (เจ้าของงานเลือก) — แถวยังอยู่ ขึ้นว่า "ลบข้อความแล้ว"
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workOrderId, id])
}

// อ่านถึงข้อความไหนแล้ว (ต่อคน ต่อใบ) — ป้ายตัวเลขแชทที่ยังไม่อ่าน
model WorkOrderChatRead {
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadId  Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@id([workOrderId, userId])
}

// ประวัติทุกครั้งที่ใบงานเปลี่ยนมือหรือเปลี่ยนสถานะ
//
// เหมือน OutageNoteLog — ช่องบนใบงานบอกได้แค่สภาพล่าสุด พอมีคนแก้ทับ
// ก็ไม่เหลือร่องรอยว่าใครทำอะไรไว้ก่อนหน้า
model WorkOrderLog {
  id           Int       @id @default(autoincrement())
  workOrderId  Int
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id])
  // CREATED | ASSIGNED | STARTED | CLOSED | CANCELLED | REOPENED | EDITED
  action       String
  // สภาพหลังทำรายการนี้ เก็บเป็น snapshot เพื่ออ่านย้อนหลังแล้วเข้าใจได้ทันที
  status       String
  note         String?
  createdAt    DateTime  @default(now())
  // แอดมินกรอกย้อนหลัง (ปิดงานย้อนหลัง) — createdAt คือวันเวลาจริงของงานที่แอดมินใส่
  // ส่วนนี่คือเวลาที่กดบันทึกจริง ไทม์ไลน์ใช้ติดป้าย "บันทึกย้อนหลัง" ให้รู้ว่าไม่ได้กดตอนนั้น
  backfilledAt DateTime?
  // ข้อมูลประกอบของรายการ — ตอนนี้ใช้กับ ROLLED_BACK: ค่าที่ถูกล้างตอนย้อนขั้น (ทีม วันนัด ผลเช็คคลัง ฯลฯ)
  // เก็บที่ประวัติไม่ใช่ที่ใบงาน เพราะใบงานต้องว่างจริง (ไม่งั้นโผล่บนบอร์ดแผนงานทีมเดิม) แต่ขั้นที่ย้อนไปต้องเติมค่าเดิมได้
  meta         Json?

  @@index([workOrderId, createdAt])
}

// หัวหน้าภาคส่งกลับให้แอดมินตรวจสอบ โดยขั้นตอนไม่เปลี่ยน (เจ้าของงานขอ ต.ค. 69)
// เช่น เลขเครื่องผิด เบอร์ร้านผิด น่าจะเป็นใบซ้ำ — เดิมต้องโทรบอกกันเอง ไม่มีที่ให้ตามว่าแอดมินแก้แล้วหรือยัง
// แยกตารางไม่ใส่ในใบงาน: ใบหนึ่งส่งได้หลายรอบ และคำขอที่จบแล้วต้องเหลือไว้ดูย้อนหลัง
// ยังเปิด = ยังไม่ตอบและไม่ยกเลิก (เข้ากล่องงานแอดมิน) · ตอบแล้วแต่ยังไม่รับทราบ = การ์ดหัวหน้าภาคโชว์คำตอบ
model AdminReview {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  // เรื่องที่ให้ตรวจ — ADMIN_REVIEW_REASONS ใน utils/constants.ts
  reason      String
  note        String
  // ขั้นของใบตอนส่ง — ระหว่างรอ หัวหน้าภาคยังเดินขั้นต่อได้ แอดมินต้องรู้ว่าส่งมาตอนอยู่ขั้นไหน
  status      String
  createdById Int?
  createdBy   User?     @relation("AdminReviewsSent", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  reply       String?
  repliedById Int?
  repliedBy   User?     @relation("AdminReviewsAnswered", fields: [repliedById], references: [id], onDelete: SetNull)
  repliedAt   DateTime?
  // หัวหน้าภาคกดรับทราบคำตอบ — การ์ดเลิกโชว์กล่องคำตอบ
  ackAt       DateTime?
  cancelledAt DateTime?

  @@index([workOrderId, createdAt])
}

// รูปหรือวิดีโอที่แนบมากับใบงาน
//
// ไฟล์จริงอยู่บนที่เก็บไฟล์ภายนอก (Supabase Storage) ไม่ได้อยู่ในฐานข้อมูลนี้
// เพราะวิดีโอคลิปเดียว 1 นาทีใหญ่กว่าข้อมูลทั้งระบบรวมกันหลายเท่า และพื้นที่
// ฐานข้อมูลแพงกว่าพื้นที่เก็บไฟล์มาก — ที่นี่เก็บแค่ที่อยู่ของไฟล์กับรูปย่อ
//
// รูปย่อเก็บไว้ที่นี่โดยตั้งใจ (ไม่กี่สิบ KB) เพราะถ้าเก็บแต่ที่อยู่ หน้าใบงานจะเห็น
// แค่ตัวหนังสือ หัวหน้าภาคที่ไล่ดูยี่สิบใบต้องกดเปิดทีละใบยี่สิบครั้ง
// และถ้าวันหนึ่งไฟล์ในถังถูกย้ายหรือลบ อย่างน้อยยังเหลือภาพให้รู้ว่าเคยมีอะไร
model WorkOrderAttachment {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // IMAGE | VIDEO — ดูที่ ATTACHMENT_KINDS ใน src/utils/constants.ts
  kind      String
  // NAMEPLATE = รูปป้ายรุ่นที่ติดอยู่บนเครื่อง · ว่าง = รูปหน้างานทั่วไป
  //
  // แยกไว้เพราะสองอย่างนี้ถูกใช้คนละแบบ — รูปหน้างานคือหลักฐานว่าเจออะไร
  // ส่วนรูปป้ายรุ่นคือที่มาของรุ่นเครื่องที่กรอกไว้ เอาไว้ย้อนดูตอนสงสัยว่า
  // ใส่รุ่นถูกหรือเปล่า ปนกันแล้วหาไม่เจอ
  role      String?
  fileName  String
  mimeType  String
  sizeBytes Int

  // ── ที่อยู่ของไฟล์จริงในถัง ──
  //
  // เก็บเป็น key ในถัง (เช่น work-orders/WO-2026-0001/17590000-photo.jpg)
  // ไม่ได้เก็บเป็น URL เพราะถังไม่ได้เปิดสาธารณะ — รูปในนี้เป็นภาพหน้าร้านลูกค้า
  // เวลาจะดูต้องขอลิงก์ชั่วคราวจากเซิร์ฟเวอร์ทีละครั้ง ลิงก์หมดอายุใน 2 ชั่วโมง
  objectKey  String?
  // ว่าง = อัปขึ้นที่เก็บไม่สำเร็จ ยังเหลือแต่รูปย่อ ให้ลองใหม่ได้
  uploadedAt DateTime?

  // รูปย่อ ~20 KB เก็บที่นี่เพื่อให้ใบงานแสดงภาพได้โดยไม่ต้องขอลิงก์ทีละรูป
  thumbnail Bytes?

  // หลักฐานเคลม (role CLAIM_*) เป็นของอะไหล่ชิ้นไหน — ใบเคลมหนึ่งใบต่ออะไหล่หนึ่งชิ้นตามฟอร์ม
  // เปลี่ยนหลายชิ้นในใบงานเดียว รูปอะไหล่เก่าของแต่ละชิ้นต้องไม่ปนกัน
  sparePartId Int?

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([workOrderId, createdAt])
}

// แผนของทีมหนึ่งในวันหนึ่ง — ใครไปกับใคร รถคันไหน ใครเป็นคนจัด
//
// ไม่ได้เก็บว่าไปที่ไหนบ้าง เพราะนั่นคือใบงานที่นัดวันนั้นของทีมนั้นอยู่แล้ว
// เก็บซ้ำไว้ที่นี่จะได้ความจริงสองชุดที่วันหนึ่งไม่ตรงกัน — แก้วันนัดในใบงาน
// แล้วบอร์ดยังโชว์วันเดิม ตารางนี้เก็บเฉพาะสิ่งที่ใบงานไม่รู้
model TeamDayPlan {
  id          Int                 @id @default(autoincrement())
  // วันอย่างเดียว เก็บที่เที่ยงคืน UTC แบบเดียวกับ WorkOrder.scheduledAt
  date        DateTime
  team        String
  vehicleId   Int?
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  note        String?
  // เวลาเข้าหน้างานของทีมวันนั้น "HH:MM" — ว่าง = ยังไม่กำหนด
  // ไม่ใช่เวลานัดของใบงาน (อยู่ที่ใบงานแต่ละใบ) แต่เป็นเวลาที่ทีมเริ่มเข้างานวันนั้น
  startTime   String?
  plannedById Int?
  plannedBy   User?               @relation(fields: [plannedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime            @updatedAt
  members     TeamDayPlanMember[]

  @@unique([date, team])
}

model TeamDayPlanMember {
  id       Int         @id @default(autoincrement())
  planId   Int
  plan     TeamDayPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId   Int
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // คนแรกที่เลือกคือหัวหน้าทีมของวันนั้น
  position Int         @default(0)

  @@unique([planId, userId])
}

// ชื่อทีมเดิม → ชื่อใหม่ ที่แอดมินเปลี่ยนในแอป (หน้า ทีมช่าง)
//
// ชื่อทีมมาจากไฟล์ทะเบียนสาขาและไฟล์เครื่องที่อัปวันละสองครั้ง ถ้าไฟล์ยังเขียนชื่อเดิมอยู่
// การอัปรอบถัดไปจะเขียนชื่อเดิมกลับลงสาขา แล้วช่าง/หัวหน้าภาคที่ย้ายไปชื่อใหม่แล้วจะมองไม่เห็นงาน
// ตัวนำเข้าทั้งสองจึงแปลงชื่อผ่านตารางนี้ก่อนบันทึก (utils/teamAliases.ts)
// สาขาที่แอดมินย้ายทีมช่างในแอป (หน้า "ทีมช่าง" → ย้ายสาขาเข้าทีม)
//
// ไฟล์ทะเบียนสาขาถูกอัปซ้ำเป็นประจำ และเขียนทีมช่างของทุกสาขาทับจากไฟล์ — ถ้าไม่จำไว้
// การอัปรอบถัดไปจะดึงสาขากลับไปทีมเดิม ช่างของทีมใหม่มองไม่เห็นงานทันที (แบบเดียวกับ TeamRename)
// หนึ่งแถวต่อสาขาต่อช่อง (zone = ทีม CM, pmTeam = ทีม PM) · ลบแถว = กลับไปเชื่อไฟล์
model BranchTeamMove {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // "zone" | "pmTeam"
  field     String
  // ทีมก่อนย้ายครั้งแรก — ใช้ตอน "คืนตามไฟล์"
  fromTeam  String?
  toTeam    String
  movedById Int?
  createdAt DateTime @default(now())

  @@unique([branchId, field])
}

// ภาค/ประเภทสาขาที่แอดมินแก้ในหน้าจัดการสาขา — ตัวนำเข้าไฟล์ทะเบียนและไฟล์เครื่องใช้ค่านี้แทนค่าในไฟล์
//
// แยกจาก BranchTeamMove เพราะอันนั้นหน้าทีมช่างแสดงเป็นรายการ "ย้ายสาขาเข้าทีม" ทั้งตาราง
// ถ้าไม่จำไว้ ไฟล์เครื่องที่อัปวันละสองครั้งจะเขียนค่าเดิมกลับทันที แอดมินแก้แล้วเหมือนไม่ได้แก้
model BranchPin {
  id         Int      @id @default(autoincrement())
  branchId   Int
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // "region" | "ownership" | "name"
  field      String
  // ค่าก่อนแก้ครั้งแรก — แก้กลับเป็นค่านี้ = เลิกบังคับ
  // ชื่อ (name · พ.ย. 69): ตัวนำเข้ารายงานเครื่องเขียนชื่อในไฟล์ล่าสุดทับให้ทุกรอบ — "คืนตามรายงาน" ต้องได้ชื่อที่ต้นทางใช้ตอนนี้
  // ไม่ใช่ชื่อเมื่อหลายเดือนก่อนตอนแก้ครั้งแรก (ภาค/ประเภทไม่ทำแบบนี้ ไฟล์ทะเบียนอัปไม่บ่อยและไม่ได้มีทุกสาขา)
  fromValue  String?
  value      String
  pinnedById Int?
  createdAt  DateTime @default(now())

  @@unique([branchId, field])
}

// ประวัติของสาขา — แก้ชื่อ · คืนชื่อตามรายงาน · ปิดสาขา · เปิดสาขาอีกครั้ง (พ.ย. 69)
//
// ก่อนหน้านี้สาขาไม่มีประวัติ: BranchPin/BranchTeamMove เก็บแค่ค่าที่บังคับอยู่ตอนนี้ cancelledNote ถูกล้างตอนเปิดคืน
// เจ้าของงานตัดสิน 4 พ.ย. 69 ว่าไม่รวมสาขา — สาขาที่เปลี่ยนคือข้อมูลใหม่ทั้งหมด สาขาเดิมเก็บประวัติของตัวเองไว้
// จึงต้องตอบได้ว่าสาขานี้เคยชื่ออะไร ใครแก้ ใครปิด เพราะอะไร เมื่อไร
// note เป็นข้อความสำเร็จรูปที่คนอ่าน (เขียนตอนนั้นเลย ชื่อคน/สาขาเปลี่ยนทีหลังได้) · meta เก็บค่าดิบไว้ตามย้อนหลัง
// ไม่ผูก relation กับ User แบบเดียวกับ Backup — ชื่อคนทำเก็บไว้ตรง ๆ ประวัติต้องอ่านออกแม้บัญชีถูกลบ
model BranchLog {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // RENAMED | NAME_RESTORED | CLOSED | REOPENED | CODE_RETIRED (สาขาเดิมยกรหัสให้สาขาใหม่) | CODE_REUSED (สาขาใหม่รับรหัสต่อ)
  action    String
  note      String
  meta      Json?
  byUserId  Int?
  byName    String?
  createdAt DateTime @default(now())

  @@index([branchId, id])
}

// ทีมรวม — พื้นที่รับผิดชอบที่ครอบคลุมหลายทีมช่าง (เช่น "Senior บางน้ำจืด หลักสี่ ลาดพร้าว",
// "ทีมเสริม กทม. + IT กทม.") ตามบันทึกแบ่งทีม
//
// ทีมช่างผูกกับสาขา (Branch.zone) ส่วนคนกลุ่มนี้ไม่ได้ดูแลสาขาชุดใดชุดหนึ่ง ถ้าใส่ชื่อนี้เป็นทีมเฉย ๆ
// จะไม่มีใบงานไหนผูกกับชื่อนี้เลย — ช่างที่สังกัดทีมรวม (User.team = name) เห็นใบงานของทุกทีมใน covers
// ใบงานยังจ่ายให้ทีมช่างจริงเสมอ ไม่จ่ายให้ทีมรวม
model TeamGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  covers    String[] @default([])
  // true = ครอบคลุมทุกทีม (งานตรวจคุณภาพ/PM ที่ไปได้ทุกที่) — ไม่ต้องไล่เพิ่มทีมใหม่ทีหลัง
  allTeams  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ทีม outsource — รับงานเป็นครั้ง ๆ ไม่ได้ดูแลสาขาประจำ (เจ้าของงานเพิ่ม ต.ค. 69: PWS SPK TBL COB STM)
//
// ทีมปกติมาจากทะเบียนสาขา (Branch.zone) — ทีมพวกนี้ไม่มีสาขาของตัวเอง จึงต้องมีรายชื่อแยก ไม่งั้นเลือกจ่ายงานไม่ได้
// ช่าง outsource ไม่มีบัญชีในแอป หัวหน้าภาคที่ดูแลสาขานั้นเป็นคนปิดงาน/แจ้งปัญหาแทน
model OutsourceTeam {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model TeamRename {
  id          Int      @id @default(autoincrement())
  fromName    String   @unique
  toName      String
  createdById Int?
  createdAt   DateTime @default(now())
}

// Super Admin "ดูในฐานะ" ใคร เมื่อไร — เจ้าของระบบอยากรู้ว่าใครเห็นหน้าจอของใครบ้าง
// ไม่ผูก relation กับ User เพราะผู้ใช้ถูกลบแบบ soft delete อยู่แล้ว และบันทึกต้องอยู่ต่อแม้บัญชีหายไป
model ViewAsLog {
  id           Int       @id @default(autoincrement())
  byUserId     Int
  targetUserId Int
  startedAt    DateTime  @default(now())
  // null = ยังดูอยู่ หรือปล่อยให้หมดเวลาเอง (โทเคนอายุ 1 ชั่วโมง)
  endedAt      DateTime?

  @@index([byUserId, startedAt])
}

// เคลมอะไหล่เก่ากับผู้ขาย ตามฟอร์ม "เอกสารใบเคลมอะไหล่" — หนึ่งแถวต่ออะไหล่หนึ่งชิ้นต่อรอบที่ปิดงาน
//
// หัวใบเคลม (สาขา วันเปิดร้าน ยี่ห้อ รุ่น หมายเลขเครื่อง อะไหล่) เก็บเป็นค่าตอนส่ง ไม่ได้อ้างไปที่ตารางอื่น
// เพราะใบเคลมเป็นเอกสารที่ส่งออกไปแล้ว — แก้ทะเบียนสาขาหรือรุ่นเครื่องทีหลัง ใบเคลมเดิมต้องไม่เปลี่ยนตาม
// ตีกลับแล้วช่างปิดใหม่ = แถวใหม่ แถวเดิมเก็บไว้เป็นประวัติว่าเคยถูกตีกลับเพราะอะไร
model PartClaim {
  id              Int       @id @default(autoincrement())
  workOrderId     Int
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePartId     Int?
  partCode        String
  partName        String
  // รหัสอะไหล่ตัวที่เสีย (ตัวที่ถอดออกและส่งเคลม) — ช่างกรอกเองจากตัวอะไหล่ (เจ้าของงานขอ ต.ค. 69)
  // partCode ข้างบนคืออะไหล่ที่เบิกมาใส่แทน · ปกติตรงกัน แต่ตัวที่ส่งคืนผู้ขายคือตัวนี้ ต้องอ่านจากของจริง
  // ว่างได้เฉพาะใบเคลมเก่าก่อนมีช่องนี้
  brokenPartCode  String?
  quantity        Int       @default(1)
  branchCode      String
  branchName      String
  branchOpenedAt  DateTime?
  brand           String?
  model           String?
  machineCode     String?
  // อาการ/สาเหตุ · ช่างเข้าเช็คอะไรบ้าง จึงระบุว่าควรเปลี่ยนชิ้นนี้ — ช่องที่ช่างกรอกเองตามฟอร์ม
  symptom         String
  checkNote       String
  // Troubleshooting ที่ทำ (ข้อ 4) — รายการข้อที่ติ๊ก · ว่าง = ยี่ห้อนี้ไม่ต้องทำ
  troubleshooting String[]  @default([])
  // ข้อมูลป้ายรุ่น { family, fields: [{ key, label, value, source: SCAN|HAND, crop? }] } — สแกนด้วยกล้องหรือพิมพ์เอง
  // crop = ภาพบรรทัดที่อ่าน (JPEG เล็ก) ให้ Admin Spare Part เทียบกับค่าได้ · ใบเคลมเก่าก่อน ต.ค. 69 ว่าง
  nameplate       Json?
  // เช็คตามคู่มือ Error in Field (Alliance) { errorCode, errorName, checked[], install: [{ key, label, note, answer }] }
  // ช่างแค่ตอบตามรายการ ระบบไม่ตัดสินว่ารับประกันหรือไม่ · ยี่ห้ออื่นว่าง
  fieldCheck      Json?
  // PENDING รอตรวจ · APPROVED อนุมัติ (ออกใบเคลมได้) · REJECTED ตีกลับ · DECLINED ปิดเคลม ไม่ส่งผู้ขาย (ก้อน 3 — ไม่ออกใบเคลม)
  // ตัดสินทีละชิ้น: แถวที่ผ่าน/ปิดเคลมล็อกชิ้นนั้นไว้จนกว่าจะเปิดใบใหม่ (ส่งซ้ำไม่ได้ · ต้องอยู่ในอะไหล่ที่ใช้)
  status          String    @default("PENDING")
  // เหตุผลตีกลับ — แถวที่ DECLINED เก็บเหตุผลที่ปิดเคลมไว้ช่องเดียวกัน ("หมดประกัน" · "ไม่ใช่ชิ้นในประกัน" · "อื่น ๆ: …")
  // ตีกลับแบบชี้ช่องโดยไม่พิมพ์เหตุผล (ก้อน 4) เซิร์ฟเวอร์เขียนชื่อช่องลงที่นี่ให้ — ประวัติเคลม/Excel/แอปเก่าที่ไม่รู้จัก reviewFlags ยังอ่านรู้เรื่อง
  rejectReason    String?
  // ช่องที่ Admin Spare Part ติ๊กให้แก้ตอนตีกลับ (ก้อน 4) — ช่างเห็นเฉพาะช่องเหล่านี้ และส่งใหม่ไม่ได้จนกว่าจะแก้หรืออธิบาย
  // ช่องของเครื่อง (MODEL SERIAL PLATE_OTHER ERROR_CODE CLAIM_ERROR_VIDEO CLAIM_SYMPTOM) ติดทุกแถวที่ถูกตีกลับทั้งใบในรอบนั้น · แถวเก่าว่าง
  // คำอธิบาย "ค่าเดิมถูกแล้ว" ของช่างไม่อยู่ที่นี่ — อยู่ในประวัติ CLAIM_SUBMITTED (meta.keep) เพราะเป็นคำตอบของรอบที่ส่งใหม่ ไม่ใช่ของแถวที่ถูกตีกลับ
  reviewFlags     String[]  @default([])
  createdById     Int?
  createdAt       DateTime  @default(now())
  reviewedById    Int?
  reviewedAt      DateTime?

  @@index([workOrderId, createdAt])
  @@index([status])
}

// ไฟล์สำรองข้อมูล (Super Admin) — ตัวไฟล์อยู่ในที่เก็บไฟล์ (ไม่เป็นสาธารณะ) ตารางนี้จำว่ามีไฟล์ไหนบ้าง
// สองไฟล์ต่อรอบ: Excel ให้คนเปิดอ่าน · ไฟล์กู้คืน (.json.gz) ให้ scripts/restore-backup.js เอากลับเข้าฐานข้อมูล
// ไม่ผูก relation กับ User — ผู้ใช้ถูกลบแล้วประวัติการสำรองต้องยังอยู่ จึงเก็บชื่อไว้ตรง ๆ
model Backup {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  // AUTO รอบ 17:00 · MANUAL กดเอง
  kind       String
  // วันที่ (เวลาไทย) ของรอบอัตโนมัติ — กันทำซ้ำในวันเดียวกันเมื่อเซิร์ฟเวอร์ตื่นหลายรอบ
  dayKey     String?  @unique
  byUserId   Int?
  byName     String?
  excelKey   String
  excelBytes Int
  dataKey    String
  dataBytes  Int
  // จำนวนแถวของตารางหลัก ไว้โชว์ในรายการ (ใบงาน / สาขา / ผู้ใช้)
  summary    Json?
}

// ช่วงเวลาที่ผู้ใช้ใช้แอปอยู่ — แถวละ 5 นาทีต่อคน (หน้า "การใช้งานแอป" ของ Super Admin/แอดมิน · ต.ค. 69)
//
// จดเป็นช่วง ไม่ใช่ทุกคำขอ — แอปยิงคำขอหลายสิบครั้งต่อนาที เก็บทุกครั้งตารางโตเป็นล้านแถวต่อเดือน
// ทั้งที่คำถามจริงมีแค่ "ใช้ตอนไหน นานเท่าไร" · ไม่จดว่าเปิดหน้าไหน/ทำอะไร (เป็นงานของไทม์ไลน์ใบงาน)
// เก็บ 90 วัน (ลบของเก่าวันละครั้ง — utils/usage.ts)
model UsageSlot {
  userId Int
  // จุดเริ่มของช่วง 5 นาที (UTC)
  slot   DateTime
  // WEB = คอม · MOBILE = มือถือ — เดาจาก User-Agent ของคำขอแรกในช่วงนั้น
  device String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@index([slot])
}

// Maid (COCO) ประจำสาขาไหน (เจ้าของงานเพิ่ม ต.ค. 69 · ไฟล์รายชื่อ Maid คอลัมน์ ERP)
// แยกเป็นตารางไม่ใช่ช่องในสาขาแบบ cocoSupervisorId — สาขาหนึ่งมี Maid ได้หลายคน (หลายกะ) และ Maid หนึ่งคนดูหลายสาขาได้
// มี id ของตัวเองเพราะระบบสำรองข้อมูลไล่อ่านทีละหน้าตามคอลัมน์ id
model CocoMaidBranch {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation("CocoMaid", fields: [userId], references: [id], onDelete: Cascade)
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([branchId])
}

// อัปเดตข้อมูลอะไหล่จากไฟล์ Excel ในแอป (เจ้าของงานขอ ต.ค. 69) — 1 แถวต่อไฟล์ที่อัปเดต
// เก็บรายงานไว้เปิดดูย้อนหลัง/ดาวน์โหลดได้ ("อัปเดตจากไฟล์ล่าสุด … ดูรายละเอียด") ไม่ต้องจำเองว่าเปลี่ยนอะไรไป
// batchId = รอบที่กดอัปเดตพร้อมกันหลายไฟล์ (แอปส่งไฟล์ทีละไฟล์ เพราะไฟล์ที่มีรูปในเซลล์ใหญ่ได้หลายสิบ MB)
model SparePartImport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  batchId   String
  byUserId  Int?
  byName    String?
  fileName  String
  // จำนวนต่อผล: created · updated · images · same · skipped · notInFile
  summary   Json
  // รายการที่เปลี่ยน/ข้าม (ไม่มีรูป) — ใช้ทำหน้ารายงานและไฟล์ Excel
  details   Json
  // ไฟล์ยี่ห้อของการอัปโหลดครั้งนี้ (ตามชื่อไฟล์ หรือที่แอดมินเลือก) · ว่าง = อัปโหลดก่อนมีกติกานี้และชื่อไฟล์ไม่บอกยี่ห้อ
  // หัวช่องเลือกอะไหล่ "อัปเดต {วันที่}" อ่านการอัปโหลดล่าสุดของไฟล์นั้นจากที่นี่
  brandFile String?

  @@index([batchId])
  @@index([createdAt])
  @@index([brandFile, createdAt])
}

// ช่างเลือกอะไหล่ตอนตรวจหน้างาน แล้วส่งให้หัวหน้าภาคคอนเฟิร์ม (เจ้าของงานขอ ต.ค. 69)
// แยกจาก WorkOrderPart โดยตั้งใจ — ของที่ยังไม่คอนเฟิร์มต้องไม่ขึ้นกระดานติดตามเครื่องเสีย/รายงานอะไหล่ที่ต้องสั่ง
// (ช่างเลือกผิดแล้วถูกตีกลับ คนสั่งของจะเห็นของผิด) · คอนเฟิร์มแล้วค่อยเขียนเป็น WorkOrderPart WAITING
// แถวละหนึ่งรอบที่ส่ง — ตีกลับแล้วส่งใหม่เป็นแถวใหม่ หัวหน้าภาคเทียบกับรอบก่อนได้ ประวัติไม่ถูกเขียนทับ
// รอบที่ยังเปิดอยู่ดูจากแถวล่าสุดของใบเท่านั้น — แถวเก่าที่ถูกตีกลับจะไม่กลับมาเปิดเองเมื่อรอบหลังถูกปิด
model PartsPick {
  id           Int             @id @default(autoincrement())
  workOrderId  Int
  workOrder    WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  // ส่งรอบที่เท่าไรของรอบตรวจนี้ — ตีกลับแล้วส่งใหม่ +1
  round        Int             @default(1)
  // PENDING รอหัวหน้าภาค · CONFIRMED เขียนลง WorkOrderPart แล้ว · RETURNED ตีกลับให้ทีมที่ไปตรวจแก้
  status       String          @default("PENDING")
  // ไฟล์ยี่ห้อของเครื่องตอนส่ง (Haier · Huebsch · Maytag · Oasis · Spinz · Other) — ยี่ห้อเครื่องถูกแก้ทีหลังจะได้รู้ว่าเลือกจากไฟล์ไหน
  brandFile    String?
  // ทีมที่ไปตรวจตอนส่ง — ตีกลับแล้วกลับไปที่ทีมนี้ทั้งทีม ไม่ใช่ช่างคนเดียว
  team         String?
  // "ตรวจแล้วเจออะไร" ตอนส่ง — ส่งใหม่หลังตีกลับต้องแก้อะไรสักอย่าง เทียบกับค่านี้
  note         String?
  createdById  Int?
  createdBy    User?           @relation("PartsPicksSent", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  reviewedById Int?
  reviewedBy   User?           @relation("PartsPicksReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  // เหตุผลที่ตีกลับ (บังคับ) — ทีมเห็นบนการ์ดแดงและกล่องแดงบนฟอร์ม ไม่ไปถึงร้าน
  reason       String?
  // รอบนี้จบโดยไม่ได้คอนเฟิร์ม/ตีกลับ (ส่งตรวจใหม่ · ย้อนขั้น · ยกเลิก · ปิดใบ · บันทึกแทนช่าง) — ไม่ถือว่ารอใครอยู่อีก
  voidedAt     DateTime?
  voidNote     String?
  items        PartsPickItem[]

  @@index([workOrderId, id])
}

// อะไหล่หนึ่งรายการที่ช่างเลือก — มี id ของตัวเองเพราะระบบสำรองข้อมูลไล่อ่านทีละหน้าตามคอลัมน์ id
model PartsPickItem {
  id          Int       @id @default(autoincrement())
  pickId      Int
  pick        PartsPick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  // หัวหน้าภาคกด OK (ตรง) / NO (ไม่ตรง) — ตัวที่ NO ขึ้นป้ายแดงให้ช่างรู้ว่าต้องแก้ตัวไหน (บทเรียนจากเคลม)
  mark        String?

  @@unique([pickId, sparePartId])
  @@index([sparePartId])
}

// อะไหล่อยู่ในไฟล์ยี่ห้อไหนบ้าง (เจ้าของงานตอบ 31 ต.ค. 69) — ไฟล์ = ชื่อไฟล์ Excel ที่อัปโหลด ไม่ใช่ช่อง "ยี่ห้อสินค้า"
// รหัสเดียวอยู่ได้หลายไฟล์ (SPOT0081 อยู่ทั้งไฟล์ Haier และ Other) — เดิมเก็บยี่ห้อเดียวต่อรหัส ไฟล์ที่อัปทีหลังทับ
// ตัวที่ใช้ร่วมจะหายจากอีกยี่ห้อทันทีที่ล็อกยี่ห้อ
// แยกตาราง ไม่ใช่ช่อง array ใน SparePart: updatedAt ของ SparePart คือตัวกันแคชรูปอะไหล่ (?v=) — ใส่ไฟล์ทีละรหัสแล้วรูปโหลดใหม่ทั้งระบบ
// และต้องรู้ว่าแถวไหนเจอในไฟล์จริง แถวไหนเดาจากช่องยี่ห้อตอนขึ้นระบบ (source)
// อัปโหลดเพิ่มได้อย่างเดียว ไม่ลบ (กติกาเดียวกับอะไหล่ที่ไม่อยู่ในไฟล์) — เอาออกได้ที่ฟอร์มอะไหล่
// มี id ของตัวเองเพราะระบบสำรองข้อมูลไล่อ่านทีละหน้าตามคอลัมน์ id
model SparePartBrandFile {
  id          Int       @id @default(autoincrement())
  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  // Haier · Huebsch · Maytag · Oasis · Spinz · Other (BRAND_FILES ใน utils/brandFile.ts)
  file        String
  // SEED = เดาจากช่องยี่ห้อตอนขึ้นระบบ · IMPORT = เจอในไฟล์ที่อัปโหลด · MANUAL = แอดมินติ๊กในฟอร์มอะไหล่
  // อัปโหลดครบ 6 ไฟล์แล้วยังเหลือ SEED = รหัสที่ไม่มีไฟล์ไหนยืนยัน
  source      String    @default("IMPORT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([sparePartId, file])
  @@index([file, sparePartId])
}

// ค่าตั้งค่าที่แอดมินเปลี่ยนได้ (ตอนนี้มี "dispatchCutoff" = เวลาปิดรับปล่อยงาน "HH:MM" · เจ้าของงานขอ ต.ค. 69)
// เปลี่ยนแต่ละครั้งเป็นแถวใหม่ ไม่แก้แถวเดิม: แถวล่าสุดของ key = ค่าตอนนี้ · แถวก่อนหน้า = เปลี่ยนจากอะไร ใครเปลี่ยน
// แถวแรกของ key ใส่โดย migration — createdAt ของมันคือเวลาที่เริ่มใช้กฎ (ไม่ล็อกใบที่เส้นตายอยู่ก่อนหน้านั้น)
// แถวแรกต้องตามไปกับไฟล์สำรอง: อ่านเวลาเริ่มจาก _prisma_migrations ไม่ได้ เพราะกู้ลงฐานใหม่แล้วกลายเป็นเวลาที่กู้
model AppSetting {
  id          Int      @id @default(autoincrement())
  key         String
  value       String
  createdById Int?
  createdBy   User?    @relation("AppSettingsChanged", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([key, id])
}

// ประวัติการนำเข้าไฟล์ (เจ้าของงานอนุมัติตัวอย่าง 5 พ.ย. 69) — หนึ่งแถวต่อ "รอบ" ที่บันทึกจริง (ไม่นับการดูตัวอย่าง)
// ใบแจ้งซ่อม · ทะเบียนสาขา · สาขาที่ยกเลิก · รถ · รายชื่อผู้ใช้ เก็บที่นี่ · อะไหล่ (SparePartImport) กับรายงานเครื่อง
// (MachineImport) มีประวัติของตัวเองอยู่แล้ว หน้าประวัติอ่านจากตารางเดิมตรง ๆ ไม่ลอกมาซ้ำ — ที่นี่มีแค่รายงานเครื่องที่บันทึกไม่สำเร็จ
// (MachineImport เขียนเฉพาะรอบที่สำเร็จ)
// ไม่เก็บตัวไฟล์ (เจ้าของงานเลือก) — ไฟล์ฟอร์มแจ้งซ่อมมีชื่อ/เบอร์ผู้ติดต่อสาขาซึ่งอยู่ในใบงานแล้ว เก็บแค่ผลที่หน้าประวัติแสดง
// byUserId ไม่ผูก FK แบบ SparePartImport — ลบผู้ใช้ถาวรแล้วประวัติต้องยังอยู่ (byName จำชื่อไว้)
model ImportRun {
  id         Int            @id @default(autoincrement())
  // REPAIR_FORM · BRANCH · BRANCH_CANCELLED · VEHICLE · USER_ROSTER · USER_AREA · MACHINE (เฉพาะรอบที่ล้ม)
  kind       String
  // รหัสรอบที่แอปส่งมากับทุกชุดของการกดยืนยันครั้งเดียว (ใบแจ้งซ่อมยืนยันทีละ 10 แถว — ทุกชุดคือรอบเดียว)
  // ว่าง = นำเข้าแบบคำขอเดียว (ไฟล์อื่นทุกชนิด)
  runKey     String?        @unique
  fileName   String
  // sha256 ของไฟล์ (ไม่ใช่ตัวไฟล์) — แอปรุ่นก่อนที่ส่งทีละชุดแต่ไม่มีรหัสรอบ จัดชุดของไฟล์เดียวกันเข้ารอบเดียวด้วยค่านี้
  fileHash   String?
  byUserId   Int?
  byName     String?
  // RUNNING · DONE · STOPPED (คนกดหยุด / เวลาหมดแบบแอปรุ่นก่อน) · FAILED (เซิร์ฟเวอร์ทำไม่สำเร็จ)
  // RUNNING ที่เงียบเกิน 5 นาที = แอปหายไปกลางทาง — หน้าประวัติตัดสินตอนอ่าน (ไม่มีงานเบื้องหลังมาแก้ค่า)
  status     String
  startedAt  DateTime       @default(now())
  // ชุดล่าสุดที่เข้ามา — ใช้ตัดสินว่ารอบที่ค้าง RUNNING ยังเดินอยู่ไหม
  lastAt     DateTime       @default(now())
  finishedAt DateTime?
  rowsInFile Int            @default(0)
  // ยอดสรุปตามผล (ชนิดอื่นที่ไม่ใช่ใบแจ้งซ่อม) — ใบแจ้งซ่อมนับจากแถวตอนอ่าน (เก็บครบทุกแถวอยู่แล้ว)
  summary    Json
  // ข้อความภาษาไทยที่ผู้ใช้เห็นตอนล้ม/หยุด
  error      String?
  rows       ImportRunRow[]

  @@index([startedAt])
  @@index([kind, startedAt])
  @@index([byUserId, fileHash])
}

// ผลทีละแถวของรอบนำเข้า — ใบแจ้งซ่อมเก็บทุกแถว · ชนิดอื่นเก็บเฉพาะแถวที่เปลี่ยนหรือมีปัญหา
// ไม่มีชื่อ/เบอร์ผู้ติดต่อ · รหัสผ่าน · เลข Fleet Card / Easy Pass (ตารางนี้อยู่ในไฟล์สำรองด้วย)
model ImportRunRow {
  id      Int       @id @default(autoincrement())
  runId   Int
  run     ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // เลขแถวในไฟล์ · ว่าง = รายการที่ไม่ได้มาจากแถวเดียว (เช่นสาขาที่ยกเลิกทั้งสาขา)
  line    Int?
  // ใบแจ้งซ่อม: NEW · OPEN · IMPORTED · ERROR · SKIPPED · PENDING (ตั้งใจเปิดในรอบนี้แต่ยังไม่ได้เปิด) · ชนิดอื่นตามชนิด
  result  String
  // รหัสสาขา / ทะเบียนรถ / รหัสพนักงาน · ชื่อที่คู่กัน
  code    String?
  name    String?
  machine String?
  // อาการ (ใบแจ้งซ่อม) หรือสิ่งที่เปลี่ยน
  detail  String?
  // เหตุผลที่ข้าม/นำเข้าไม่ได้
  note    String?
  // รหัสใบงานที่เปิด/ที่ค้างอยู่ (WO-…)
  ref     String?

  @@index([runId, line])
}

// แจ้งเตือนเข้ามือถือ (Web Push · เจ้าของงานเลือก พ.ย. 69) — หนึ่งแถวต่อเบราว์เซอร์/แอปที่กดเปิดแจ้งเตือน
// endpoint ไม่ซ้ำ: เครื่องเดียวเปลี่ยนคนล็อกอิน = แถวเดิมย้ายไปเป็นของคนใหม่ (ไม่ส่งของคนเก่าเข้าเครื่องคนใหม่)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
